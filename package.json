{
  "name": "prl-assets",
  "description": "Локальные assets корпоративного портала PRL",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i .tools/tailwind/input.css -o public_html/assets/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i .tools/tailwind/input.css -o public_html/assets/css/app.css --watch",
    "test:prl-ui": "node --test tests/Js/prl_ui.test.mjs",
    "test": "node --test tests/Js/*.test.mjs",
    "check:architecture": "node INPUT_DATA/enterprise-llm-architecture/scripts/arch.mjs check --dir architecture --strict",
    "build:architecture": "node INPUT_DATA/enterprise-llm-architecture/scripts/build.mjs --dir architecture",
    "architecture": "npm run check:architecture && npm run build:architecture"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.1"
  },
  "private": true,
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
