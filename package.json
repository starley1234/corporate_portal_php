{
  "name": "prx-assets",
  "description": "Локальные assets корпоративного портала PRX",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i .tools/tailwind/input.css -o public_html/assets/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i .tools/tailwind/input.css -o public_html/assets/css/app.css --watch",
    "test:prx-ui": "node --test tests/Js/prx_ui.test.mjs",
    "test": "node --test tests/Js/*.test.mjs",
    "test:architecture": "node --test docs/architecture/engine/tests/*.test.mjs",
    "check:architecture": "node docs/architecture/engine/scripts/arch.mjs check --dir docs/architecture --strict",
    "build:architecture": "node docs/architecture/engine/scripts/build.mjs --dir docs/architecture",
    "architecture": "npm run check:architecture && npm run build:architecture"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.1"
  },
  "private": true,
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
