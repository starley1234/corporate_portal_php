# PRX: окружение отдельного процесса воркера. Секреты сайта здесь не наследуются.
WORKER_QUEUE_MODE=pg
WORKER_PG_DSN=postgres://prx:prx@127.0.0.1:5432/prx
PRX120_API_URL=http://localhost:8080/prx120/api
WORKER_API_TOKEN=
WORKER_SITE_TOKEN=
PRX120_API_BASE=http://localhost:8080
PRX115_API_BASE=http://localhost:8080/prx115/api
PRX115_SITE_TOKEN=
WORKER_NAME=worker-1
WORKER_CHANNELS=echo,embeddings.index,llm.summarize,semantic.index
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5
WORKER_LOG_LEVEL=INFO
# Провайдер по умолчанию: local | openrouter | toolforge. Пусто = первый настроенный.
LLM_DEFAULT_PROVIDER=local
LOCAL_API_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_DEFAULT_MODEL=qwen3-coder-30b-a3b-instruct
# Модель платформы для модулей без своей PRX###_MODEL. Формат провайдер::модель.
DEFAULT_LLM_MODEL=local::unsloth/qwen3.8-27b
# Отдельный корпоративный шлюз (не второе имя local).
TOOLFORGE_API_URL=
TOOLFORGE_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# OCR-библиотека; активного канала обработки документов пока нет.
# tesseract — локально/dev, remote — внешний сервис.
# Remote получает PDF (multipart, поле file) и отвечает JSON:
# {"text": "...", "pages": 3, "engine": "docling", "confidence": 0.93}
OCR_PROVIDER=tesseract
OCR_SERVICE_URL=
OCR_TIMEOUT=120
# Remote OCR: токен и параметры парсинга. Заголовок по умолчанию —
# Authorization: Bearer; OCR_AUTH_HEADER_NAME=X-API-Key отправляет сырой ключ.
OCR_API_KEY=
OCR_AUTH_HEADER_NAME=
# JSON-объекты. OCR_EXTRA_PARAMS уходит в multipart data= (output_format, lang…),
# OCR_EXTRA_HEADERS добавляет произвольные HTTP-заголовки.
OCR_EXTRA_PARAMS={}
OCR_EXTRA_HEADERS={}
