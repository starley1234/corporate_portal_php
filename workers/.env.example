# =============================================================================
# N2J — воркеры. Скопируйте в workers/.env и настройте.
# =============================================================================

# Как ходить в очередь: pg (прямой доступ к PostgreSQL) | http (через PHP API)
WORKER_QUEUE_MODE=pg

# Прямой доступ к БД (для WORKER_QUEUE_MODE=pg)
WORKER_PG_DSN=postgres://n2j:n2j@127.0.0.1:5432/n2j

# PHP API очереди (для WORKER_QUEUE_MODE=http, воркеры на отдельном сервере).
# Этот же адрес служит источником адреса сайта для доставки результатов: каналы
# с полным путём (semantic.index → /nj115/api/vectors) берут из него корень,
# поэтому второй раз вписывать сайт не нужно.
NJ120_API_URL=https://n2j.ru/nj120/api
WORKER_API_TOKEN=

# Общий токен САЙТА для отправки результатов (NJxxx_*_SITE_TOKEN перекрывают его).
# Значение — тот же WORKER_API_TOKEN из .env САЙТА. Отдельная переменная потому,
# что в режиме pg сам WORKER_API_TOKEN должен быть пуст (см. config.py).
WORKER_SITE_TOKEN=

# Общий адрес САЙТА — запасной для каналов, у которых не задан свой NJxxx_API_BASE.
# Пишите КОРЕНЬ сайта, без пути модуля: NJ120_API_URL выше — это API очереди
# (/nj120/api), а здесь нужен адрес сайта целиком.
# Каналы, которые сами формируют полный путь (semantic.index → /nj115/api/vectors),
# работают от одного этого адреса; модульные каналы с коротким путём (например
# /radar/api/items) тоже могут обходиться им — воркер подставит путь модуля
# (site.module_api_base). Собственный NJxxx_API_BASE нужен только если канал
# живёт на ДРУГОМ сайте.
NJ120_API_BASE=https://n2j.ru

# Имя этого воркера (видно в nj_120_jobs.claimed_by)
WORKER_NAME=worker-1

# Каналы через запятую (пусто = все зарегистрированные в handlers/)
WORKER_CHANNELS=

# Одновременно выполняемых задач на процесс
WORKER_CONCURRENCY=4

# Период опроса очереди, сек (LISTEN/NOTIFY сокращает задержку до мгновенной)
WORKER_POLL_INTERVAL=5.0
WORKER_HEARTBEAT_INTERVAL=30.0

# Пока очередь пуста, пауза опроса удваивается от WORKER_POLL_INTERVAL до этого
# потолка (сек), а на первой же задаче возвращается к обычной. При простое это
# в разы меньше запросов /nj120/api/claim — и меньше строк в логе.
# Это же значение — максимальная ЗАДЕРЖКА старта новой задачи в http-режиме
# (в pg-режиме цикл будит LISTEN/NOTIFY, задержки нет). Хотите мгновенную
# реакцию любой ценой — поставьте столько же, сколько WORKER_POLL_INTERVAL.
#WORKER_IDLE_MAX_SEC=10

# --- Логи воркера (плоский ротируемый файл) ------------------------------------
# Воркер пишет в stderr (journalctl) И в один простой файл, который удобно
# открыть и прислать при разборе инцидента: одна строка на событие, ротация по
# размеру, без внешних зависимостей. Рекомендуется оставить включённым.
#   ошибки/падения задач, сбои и таймауты модели, ответы сайта
#   («HTTP 403: Неверный токен воркера», «HTTP 500: приёмка результата упала…»),
#   доставка результатов (доставлено=true/false).
# WORKER_LOG_ENABLED=0  — логи только в stderr (как было раньше)
WORKER_LOG_ENABLED=1
# Куда писать (по умолчанию — logs/n2j-worker.log в корне каталога workers/).
# Здесь же рядом появятся архивы n2j-worker.log.1, .2 … Относительный путь
# считается от текущего каталога запуска. Если процессов воркера НЕСКОЛЬКО —
# каждому свой файл (ротация по размеру не рассчитана на общий файл):
#WORKER_LOG_FILE=/opt/n2j/workers/logs/n2j-worker.log
# Уровень: DEBUG | INFO | WARNING | ERROR (по умолчанию INFO)
#WORKER_LOG_LEVEL=INFO
# Размер одного файла, МБ, и сколько архивов хранить (по умолчанию 5 и 5)
#WORKER_LOG_MAX_MB=5
#WORKER_LOG_BACKUPS=5
#
# Шум в логе. httpx пишет INFO на КАЖДЫЙ HTTP-запрос, а воркер постоянно
# опрашивает очередь — файл заполнялся строками вида
#   INFO httpx: HTTP Request: POST https://…/nj120/api/claim "HTTP/1.1 200 OK"
# WORKER_LOG_QUIET — чьи INFO/DEBUG не писать вообще (по умолчанию httpx;
# пусто — писать всё). WORKER_LOG_SKIP — подстроки сообщений, которые режем
# (по умолчанию /nj120/api/claim). Записи WARNING и выше проходят ВСЕГДА:
# ошибки опроса очереди должны быть видны.
#WORKER_LOG_QUIET=httpx
#WORKER_LOG_SKIP=/nj120/api/claim

# --- LLM-провайдеры (OpenAI-совместимые; можно ЛЮБОЕ число) --------------------
# Провайдер = <ИМЯ>_API_URL + <ИМЯ>_API_KEY + <ИМЯ>_DEFAULT_MODEL (+ опционально
# <ИМЯ>_PROXY и <ИМЯ>_DEFAULT=1 — «этот провайдер по умолчанию»).
# Имя по умолчанию: LLM_PROVIDER → единственный <ИМЯ>_DEFAULT=1 → TOOLFORGE → первый.

# Локальный LM Studio (ToolForge):
TOOLFORGE_API_URL=http://127.0.0.1:1234/v1/
TOOLFORGE_API_KEY=
TOOLFORGE_DEFAULT_MODEL=qwen3-coder-30b-a3b-instruct
# Токен LM Studio (0.3.x+ требует Authorization: Bearer). Читается как фолбэк для
# локальных провайдеров, если <ИМЯ>_API_KEY / <ИМЯ>_API_TOKEN не заданы.
LM_API_TOKEN=
# TOOLFORGE_PROXY=http://127.0.0.1:3128
# TOOLFORGE_DEFAULT=1

# OpenRouter:
# Провайдер LLM по умолчанию (openrouter | toolforge); при пустом — встроенный дефолт
#LLM_PROVIDER=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/auto
# OPENROUTER_PROXY=
# OPENROUTER_DEFAULT=1

# Имя провайдера по умолчанию (см. выше правила выбора)
#LLM_PROVIDER=TOOLFORGE

# --- Формат моделей модулей (NJ540/NJ550/NJ570_*/NJ580_* и др.) ----------------
#   провайдер::модель   — напр. local::unsloth/gemma-4-12b-it
#                         или openrouter::google/gemini-3-flash-preview
#                         (делится по ПЕРВОМУ "::", хвост — модель как есть)
#   модель              — провайдер по умолчанию + эта модель
#   пусто               — провайдер по умолчанию + его DEFAULT_MODEL
# Примеры:
#NJ540_MODEL=openrouter::meta-llama/llama-3.3-70b-instruct:floor
#NJ550_MODEL=local::qwen3-coder-30b-a3b-instruct
#NJ570_CODE_MODEL=openrouter::openrouter::stepfun/step-3.5-flash:free

# Модель для «Отзыв 2 Ответ» (nj540.reply); пусто = DEFAULT_MODEL провайдера по умолчанию
NJ540_MODEL=

# --- Поиск вакансий (nj550.jobs): бережный режим поисковика -------------------
# Сколько поисковых запросов на задачу (<=4), пауза между ними (сек!) —
# не ужесточайте без нужды: забаненный поисковик = мёртвый сервис.
NJ550_MAX_QUERIES=3
NJ550_RESULTS_PER_QUERY=10
NJ550_MAX_RESULTS=15
NJ550_SEARCH_DELAY=2.5
NJ550_REGION=ru-ru
# Сколько страниц вакансий докачивать целиком (0 = выключено; берегите сайты)
NJ550_FETCH_PAGES=0
NJ550_FETCH_TIMEOUT=8
# Модель ранжирования (формат выше); пусто = дефолт провайдера
NJ550_MODEL=

# --- 3D-конструктор (nj570.generate / nj570.clarify / nj570.render) -------------
# Код создаёт одна модель, описание — другая (дешёвая), vision-проверка — третья.
# Формат — см. «Формат моделей модулей» выше. Пусто = дефолт провайдера.
NJ570_CODE_MODEL=
NJ570_DESC_MODEL=
NJ570_VISION_MODEL=
# Размер кадра для vision-проверки, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 512 по ТЗ).
#NJ570_PHOTO_MAX_PX=
# Рендер — ТОЛЬКО локальный OpenSCAD (n2j_workers/scad.py), внешних сервисов
# рендера нет. Бинарник УЖЕ В РЕПО: workers/openscad-renderer/bin/openscad
# (приедет с git pull; право исполнения scad.py добавит сам).
# Библиотека — склонировать ОДИН раз:
#   cd workers && mkdir -p openscad-renderer/libraries
#   git clone --depth 1 https://github.com/BelfrySCAD/BOSL2.git openscad-renderer/libraries/BOSL2
# (альтернатива — workers/libraries/BOSL2; свой путь — NJ570_OPENSCAD_LIB)
# Всё найдётся без env-переменных; они нужны только для нестандартных расположений.
NJ570_OPENSCAD_BIN=
NJ570_OPENSCAD_LIB=
NJ570_OPENSCAD_TIMEOUT=120
# отдельный таймаут STL-экспорта (CGAL бывает дольше превью)
NJ570_OPENSCAD_STL_TIMEOUT=300
# одновременные openscad-процессы (при WORKER_CONCURRENCY>1 берегите RAM)
NJ570_MAX_RENDER_PARALLEL=2
NJ570_COLORSCHEME=Starnight
# Куда выгружать готовые STL/PNG (файлы рендера живут ~60 c)
NJ570_UPLOAD_URL=https://n2j.ru/3d/api/upload
# Токен сайта для /3d/api/upload — то же значение, что WORKER_API_TOKEN в .env САЙТА.
# Отдельная переменная, потому что в режиме pg сам WORKER_API_TOKEN задавать нельзя.
NJ570_SITE_TOKEN=
# Фикс-цикл: максимум итераций «код → рендер → (vision) → правка» на задачу
NJ570_MAX_ITER=5
# DuckDuckGo-референсы: сколько результатов, пауза между запросами (сек) —
# бережный режим, не ужесточайте.
NJ570_SEARCH_MAX=3
NJ570_SEARCH_DELAY=2.5

# --- Эмбеддинг-сервер (ОТДЕЛЬНЫЙ эндпоинт) --------------------------------------
EMBEDDING_API_URL=http://127.0.0.1:1235/v1/
# Токен сервера. LM Studio 0.3.x требует Bearer даже локально — тогда сюда
# кладут его `sk-lm-…`. Для ЛОКАЛЬНОГО адреса (localhost/192.168.*/имя без
# точки) подхватывается и LM_API_TOKEN; за прокси (llm.toolforge.ru) — только
# эти EMBEDDING_* переменные, LM_API_TOKEN сам не подставляется.
EMBEDDING_API_KEY=
# Текстовая эмбеддинг-модель — ТОЛЬКО она. Мультимодальную (qwen3-vl-embedding-*)
# сюда не писать: LM Studio и большинство OpenAI-совместимых серверов отдают по
# /v1/embeddings лишь модели типа embeddings, а на чужое имя отвечают
# «No models loaded. Please load a model…» — то есть выглядят сломанными, хотя
# живы. Мультимодальный путь живёт отдельно: EMBEDDING_MM_API_URL ниже.
# Владелец 22.10.2026 вписал сюда VL-модель и получил HTTP 400; посмотреть, что
# сервер реально отдаёт: curl -s $EMBEDDING_API_URL/models -H "Authorization: Bearer $EMBEDDING_API_KEY"
# Стенд /embedbench сверяет это имя со списком сервера ДО запросов и говорит,
# что вписать.
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024

# --- nj115_semantic: поиск по смыслу (канал semantic.index) ----------------------
# Воркер считает векторы эмбеддинг-сервером и записывает их в nj_115_vectors.
# Как именно — зависит от режима очереди:
#   * режим pg — воркер пишет векторы в базу САМ (адрес сайта не нужен);
#   * режим http (воркер на отдельном сервере) — векторы принимает САЙТ,
#     POST /nj115/api/vectors, поэтому нужен адрес сайта и токен.
# Обычно вписывать НЕЧЕГО: адрес сайта берётся из NJ120_API_URL выше, а токен —
# из WORKER_API_TOKEN (в http-режиме они заданы всегда). Своя пара нужна, если
# сайт другой или адрес нестандартный. База — адрес API модуля (как у остальных
# каналов), годится и корень сайта: обработчик понимает оба варианта и не склеит
# путь дважды (тест tests/test_env_docs.py).
NJ115_API_BASE=https://n2j.ru/nj115/api
# пусто = берётся WORKER_SITE_TOKEN (общий, см. выше)
NJ115_SITE_TOKEN=
# Лимит ожидания эмбеддинг-сервера на один вызов, сек (по умолчанию 180).
#NJ115_EMBED_TIMEOUT=180

# --- NJ580: Документы организации (пакеты DOCX/PDF/XLSX по ГОСТ) ---
# модели: черновики документов / подбор набора (auto) / редактор-проверка
# (формат — см. «Формат моделей модулей» выше; пусто = дефолт провайдера).
# ВНИМАНИЕ: без префикса модель ищется у ПРОВАЙДЕРА ПО УМОЛЧАНИЮ — если это
# локальный LM Studio, OpenRouter-моделей там нет. Пишите префикс явно.
NJ580_DOC_MODEL=
NJ580_PLAN_MODEL=
NJ580_QA_MODEL=
# база API сайта: /doc (строки документов) и /upload (файлы) — токен ниже
NJ580_API_BASE=https://n2j.ru/docs/api
NJ580_SITE_TOKEN=
NJ580_MAX_DOCS=10
# бережный DuckDuckGo (как NJ550_*): число запросов и пауза, сек
# Только для diagnostics-скрипта nj580_doctor.py: pip-пакет для изолированной проверки
#NJ580_DOCTOR_PKG=
NJ580_SEARCH_MAX=2
NJ580_SEARCH_DELAY=3

# --- Дизайн страницы (nj590.design) ---------------------------------------------
# Модель генерации вариантов (формат — см. «Формат моделей модулей»); дизайн
# любит сильную модель, малые (Gemma) — с salvage-разбором, он уже в коде.
NJ590_DESIGN_MODEL=
# база API сайта (прогресс и приём вариантов) — токен ниже
# Таймаут и лимит страницы веб-чтения для дизайн-ранов nj590
#NJ590_FETCH_TIMEOUT=10
#NJ590_MAX_PAGE_BYTES=400000
NJ590_API_BASE=https://n2j.ru/design/api
NJ590_SITE_TOKEN=
# сколько вычищенного HTML уходит в промпт варианта (малые LLM — меньше)
NJ590_DESIGN_INPUT_CAP=24000

# --- Профиль компании (nj591.profile) --------------------------------------------
NJ591_PROFILE_MODEL=
NJ591_PROFILE_API_BASE=https://n2j.ru/company/api
NJ591_PROFILE_SITE_TOKEN=
# сколько страниц «О нас/Контакты/Команда» читать сверх главной (1..6)
NJ591_PROFILE_MAX_PAGES=4
# кап Markdown на страницу, знаков (малые LLM)
NJ591_PROFILE_MD_CAP=2200
# Бюджет времени на обход сайта, сек: застрявший сайт больше не оставляет сбор
# без пульса — профиль честно завершается причиной «сайт не отвечает»
NJ591_PROFILE_SITE_BUDGET=180
# Сколько страниц «Карьера / Вакансии / О компании» читать для сбора ВАКАНСИЙ
# (их принимает модуль nj642; 0 — не читать)
NJ591_PROFILE_VACANCY_PAGES=3

# --- Холодное письмо (nj592.email) ------------------------------------------------
NJ592_EMAIL_MODEL=
NJ592_EMAIL_API_BASE=https://n2j.ru/coldmail/api
NJ592_EMAIL_SITE_TOKEN=
NJ592_EMAIL_MAX_VARIANTS=5

# --- Тренды GitHub (nj593.trends) -------------------------------------------------
# модель редактора дайджеста (формат — см. «Формат моделей модулей»)
NJ593_TRENDS_MODEL=
# база API сайта (прогресс, приём позиций, завершение) — токен ниже
NJ593_TRENDS_API_BASE=https://n2j.ru/trends/api
# пусто = берётся WORKER_SITE_TOKEN (общий, см. выше)
NJ593_TRENDS_SITE_TOKEN=
# токен GitHub API (необязательно): без него 60 запросов/час, с ним 5000
NJ593_GITHUB_TOKEN=
# размер обзора по умолчанию, минимум звёзд и сколько README читать (знаков)
NJ593_TRENDS_MAX_ITEMS=10
NJ593_TRENDS_MIN_STARS=50
NJ593_TRENDS_README_CAP=2400

# --- AI Досье на работодателя (nj598.dossier) --------------------------------------
# модель аналитика досье (формат — см. «Формат моделей модулей»)
NJ598_DOSSIER_MODEL=
# база API сайта (прогресс, приём результата, ошибка) — токен ниже
NJ598_DOSSIER_API_BASE=https://n2j.ru/dossier/api
# пусто = берётся WORKER_SITE_TOKEN (общий, см. выше)
NJ598_DOSSIER_SITE_TOKEN=
# кап Markdown на источник и максимум читаемых страниц (бережный ddgs)
NJ598_DOSSIER_MD_CAP=1800
NJ598_DOSSIER_MAX_SITES=8
NJ598_DOSSIER_SEARCH_DELAY=2.5

# --- webread: общий конвейер «страница → Markdown» (nj590/591/592 и далее) --------
# curl_cffi: TLS-отпечаток браузера (chrome124); фолбэк — httpx
WEBREAD_IMPERSONATE=chrome124
WEBREAD_FETCH_TIMEOUT=20
WEBREAD_MAX_PAGE_BYTES=3145728
# дефолтный кап Markdown, знаков (0.5–2 КБ текста — то, что нужно малым LLM)
WEBREAD_MD_CAP=2000

# --- LLM: размышления (thinking) ---------------------------------------------------
# off — выключить reasoning у думающих моделей (Qwen3/3.5, DeepSeek-R1) во ВСЕХ
# воркерах: в запрос уходит chat_template_kwargs.enable_thinking=false (локальные
# серверы) и «/no_think» в системное сообщение. Без этого 9B-модель тратит весь
# max_tokens на reasoning_content, а content приходит пустым. nj602 выключает
# thinking всегда, остальным — по этой переменной.
LLM_THINKING=off

# --- nj600_prefs: сжатие профилей предпочтений (воркер nj600.compact) ------------
NJ600_PREFS_API_BASE=
NJ600_PREFS_SITE_TOKEN=
NJ600_PREFS_MODEL=

# --- nj602_content: автостатьи (воркер nj602.article) ----------------------------
NJ602_CONTENT_API_BASE=
NJ602_CONTENT_SITE_TOKEN=
NJ602_CONTENT_MODEL=
# Старый одно-проходный сбор (действует только при NJ602_RESEARCH=0):
NJ602_CONTENT_MAX_SITES=6
NJ602_CONTENT_MD_CAP=2000
# Исследовательский конвейер «факты вместо воды» (handlers/nj602_research.py), включён по умолчанию.
NJ602_RESEARCH=1
# сколько страниц читать (3..12) и сколько знаков брать с каждой (1500..9000)
NJ602_RESEARCH_MAX_SITES=8
NJ602_RESEARCH_MD_CAP=5000
# минимум фактов с цифрами, иначе добор источников по вопросам плана
NJ602_MIN_FACTS=8
# порог ИИ-рецензента (0..10): ниже — одно переписывание по замечаниям
NJ602_CRITIC_MIN=6
# нижняя граница объёма статьи, верхняя = ×1.8
NJ602_RESEARCH_MIN_CHARS=3500

# --- nj603_kicker: «Пиналка» -------------------------------------------------------
# Планировщик живёт на САЙТЕ (Service_Nj603_Kicker): созревшее расписание
# выполняется прямым вызовом сервиса модуля, канала nj603.kick больше нет.
# NJ603_KICK_BASE оставлен только для совместимости старых деплоев.
NJ603_KICK_BASE=
# Максимальное ожидание ответа LLM для одной статьи, секунд (60–360).
NJ602_LLM_TIMEOUT=240

# --- nj605_radar: Радар заказов (воркер nj605.radar) ------------------------------
# ddgs-поиск закупок по наблюдению → LLM отбирает реальные заказы (score 0–100)
# → POST /radar/api/items. Находки с score>=85 будят nj597 (письмо+колокольчик).
NJ605_RADAR_API_BASE=https://n2j.ru/radar/api
NJ605_RADAR_SITE_TOKEN=
NJ605_RADAR_MODEL=
NJ605_RADAR_MAX_SITES=6
NJ605_RADAR_SEARCH_DELAY=2.0
# Доп. поисковые формулировки (через «|»; {query}/{region} подставляются).
# Пусто = только встроенный набор (закупка / тендер / коммерческий тендер /
# запрос предложений / ищу поставщика).
# NJ605_RADAR_QUERIES={query} малые закупки | {query} аренда тендер
# Площадки для таргетированного site:-поиска (через «|»). Пусто = встроенный
# набор: zakupki.gov.ru, rostender.info, b2b-center.ru, tenderplan.ru.
# Прямого API у площадок нет — воркер ищет только их публичную выдачу.
# NJ605_RADAR_SITE_DOMAINS=zakupki.gov.ru|rostender.info|b2b-center.ru

# --- nj642_vacancies: Вакансии компаний (воркер nj642.vacancies) -------------------
# Страницы «Карьера / Вакансии / О компании» сайта работодателя → LLM извлекает
# вакансии строго из текста → POST /vacancies/api/ingest. Сайт сам ведёт историю
# (появилась/исчезла/вернулась), связывает вакансии с мониторами и присылает
# письмо о новых подходящих (nj597).
NJ642_VACANCIES_API_BASE=https://n2j.ru/vacancies/api
NJ642_VACANCIES_SITE_TOKEN=
NJ642_VACANCIES_MODEL=
# Сколько страниц читать у одной компании (1–6; сначала «Вакансии», потом «О компании»)
NJ642_VACANCIES_PAGES=3
# Знаков на страницу (600–4000)
NJ642_VACANCIES_MD_CAP=2200
# Бюджет времени на одну компанию, сек: сбор обязан закончиться сам, а не висеть
NJ642_VACANCIES_COMPANY_BUDGET=150
# Компаний на один сбор (1–24; столько же держит сайт в мониторе)
NJ642_VACANCIES_COMPANIES=12
# Авто-режим «только город + направление»: сколько секунд отводить на подбор
# сайтов работодателей (сначала своя база и карта отрасли, затем открытый поиск;
# 30–360). Найденные компании воркер отправляет на сайт — владелец видит их
# в мониторе с пометкой, откуда компания взялась.
NJ642_VACANCIES_DISCOVER_BUDGET=120

# --- nj606_leads: Поток заказчиков (воркер nj606.leads) ---------------------------
# ddgs-поиск производителей под оффер → LLM извлекает компании (название, сайт,
# ИНН, зацепка) → POST /leads/api/companies (дедуп на сайте).
NJ606_LEADS_API_BASE=https://n2j.ru/leads/api
NJ606_LEADS_SITE_TOKEN=
NJ606_LEADS_MODEL=
NJ606_LEADS_MAX_SITES=6
NJ606_LEADS_SEARCH_DELAY=2.0

# --- nj607_industry: Карта отрасли (воркер nj607.industry) ------------------------
# Глубже nj606: 9 запросов, до 10 страниц → LLM-отчёт (игроки, цены, каналы,
# возможности входа) → /industry/api/{progress,result,fail}.
NJ607_INDUSTRY_API_BASE=https://n2j.ru/industry/api
NJ607_INDUSTRY_SITE_TOKEN=
NJ607_INDUSTRY_MODEL=
NJ607_INDUSTRY_MAX_SITES=10

# --- nj609_watchdog: Сторож контрагентов (воркер nj609.watchdog) ------------------
# ddgs: суды/банкротство/новости по компании → LLM фильтрует шум
# → POST /watchdog/api/events (severity risk/warn/info).
NJ609_WATCHDOG_API_BASE=https://n2j.ru/watchdog/api
NJ609_WATCHDOG_SITE_TOKEN=

# --- nj610_inbox: Входящие письма (воркер nj610.inbox) ---------------------------
# Воркер разбирает письма и отдаёт их сайту: база — адрес API модуля (/inbox/api),
# короткие пути /mail и /drafts. Настройки самого ящика (IMAP) — в .env САЙТА.
NJ610_INBOX_API_BASE=https://n2j.ru/inbox/api
# пусто = берётся WORKER_SITE_TOKEN (общий, см. выше)
NJ610_INBOX_SITE_TOKEN=
# Модель для разбора письма (формат — см. «Формат моделей модулей»)
NJ610_INBOX_MODEL=

# --- nj639_qc: Контроль качества (канал nj639.analyze) ---------------------------
# Адрес API сайта (воркер сам добавляет /worker_result) — как у остальных
# VLM-сервисов. Старая форма с полным путём .../qc/api/worker_result тоже
# понимается: воркер видит её и путь второй раз не добавляет.
NJ639_API_BASE=https://n2j.ru/qc/api
# пусто = берётся WORKER_SITE_TOKEN (общий, см. выше)
NJ639_SITE_TOKEN=
# Своя vision-модель сервиса (пусто — общая VLM_MODEL → модель провайдера).
#NJ639_VISION_MODEL=
# Потолок ответа, токенов (пусто — общий VLM_MAX_TOKENS, иначе 1500).
#NJ639_MAX_TOKENS=1500
# Ожидание модели, секунд (пусто — общий VLM_TIMEOUT, иначе 240). ОБЯЗАТЕЛЬНО
# меньше timeout_sec задачи: сайт ставит 1200.
#NJ639_LLM_TIMEOUT=240
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 1400).
#NJ639_PHOTO_MAX_PX=
# "1" — разрешить захват кадра с адресов локальной сети (свои IP-камеры).
# По умолчанию закрыто: это защита от SSRF через настройки источника.
#NJ639_ALLOW_LAN=0

# --- Мок-серверы и оффлайн-крючки (ТОЛЬКО разработка/песочница, в прод не ставить) --
# workers/mock/: эхо-LLM :1234 и эхо-эмбеддинги :1235 без GPU и сети.
# Порт мок-сервера (запуск: MOCK_PORT=1234 python3 workers/mock/mock_llm_server.py)
#MOCK_PORT=1234
# Имя модели в ответе мока
#MOCK_MODEL=mock-llm
# Файл с готовым ответом LLM (verbatim, обёртка OpenAI сохраняется) — для
# конвейеров со строгой JSON-схемой (nj598/nj591/nj602): свой файл на канал
#MOCK_LLM_REPLY_FILE=
# Размерность векторов мока эмбеддингов
#MOCK_DIMS=64
# Оффлайн-поиск и страницы для webread (workers/n2j_workers/webread.py):
# {"search": [{"q": "подстрока", "results": [...]}], "pages": {"url": "<html>"}}
#N2J_WEBREAD_MOCK=

# --- nj612_touch: Серии касаний (черновики follow-up писем) ---
NJ612_TOUCH_API_BASE=http://127.0.0.1/touches/api
NJ612_TOUCH_SITE_TOKEN=CHANGE_ME_равен_WORKER_API_TOKEN_сайта
NJ612_TOUCH_MODEL=

# --- nj613_digest: Дайджест руководителю (недельное резюме) ---
NJ613_DIGEST_API_BASE=http://127.0.0.1/digest/api
NJ613_DIGEST_SITE_TOKEN=CHANGE_ME_равен_WORKER_API_TOKEN_сайта
NJ613_DIGEST_MODEL=

# Минимальный объём тела статьи (знаков), ниже которого nj602 дописывает
# продолжение отдельным LLM-вызовом (1400–58000, по умолчанию 1800).
NJ602_CONTENT_MIN_CHARS=1800

# --- nj633_nettools: Сетевые инструменты (со стороны сайта) ---
# Ключи продублированы: лимиты и модель ИИ-объяснения задаются на сайте,
# читаются в Service_Nj633_Nettools; воркеру отдельный ключ не нужен —
# используется канал llm.summarize с моделью из payload задачи.
NJ633_LLM_MODEL=

# --- nj640_cameras: Камеры цеха (воркер nj640.analyze) ----------------------------
# кадр камеры → VLM → JSON-схема → вердикт (дисциплина/СИЗ/загрузка оборудования).
# Результат пишется в PG (режим pg) и/или POST /cameras/api/worker_result.
NJ640_API_BASE=https://n2j.ru/cameras/api/worker-result
NJ640_SITE_TOKEN=
# Vision-модель (пусто = NJ570_VISION_MODEL или DEFAULT_MODEL провайдера)
#NJ640_VISION_MODEL=
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 512 по ТЗ).
#NJ640_CAMERAS_PHOTO_MAX_PX=
NJ640_MAX_TOKENS=1500
# Разрешить захват кадров с локальных IP камер (192.168.*, 10.* и т.д.)
#NJ640_ALLOW_LAN=1
# Таймаут захвата кадра, сек
NJ640_CAPTURE_TIMEOUT=15

# --- nj641_imagegen: Генератор изображений (воркер nj641.generate) -----------
# описание/правка/референсы → внешний image-API → картинка (файл на сайте).
# Адрес OpenAI-совместимого image-API (AI Model Server, OpenRouter/OpenAI) —
# обязателен. Подходит база (http://127.0.0.1:8000), база с /v1 или полный
# эндпоинт (/v1/images/generations) — лишний хвост воркер отрежет сам.
NJ641_IMAGE_API=
# Токен внешнего image-API (HTTPBearer; Authorization: Bearer …)
#NJ641_API_TOKEN=
# Модель генерации (по умолчанию black-forest-labs/FLUX.2-klein-4B)
#NJ641_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# Число шагов диффузии (пусто — не передаём, решает сервер)
#NJ641_IMAGE_STEPS=
# Формат ответа image-API: b64_json (по умолчанию) или url.
# url годится, только если сервер картинок доступен браузеру пользователя.
#NJ641_RESPONSE_FORMAT=b64_json
# База САЙТА для доставки результата. Можно НЕ задавать: адрес подхватится из
# NJ120_API_URL (режим http). Подходит ЛЮБОЙ из форматов:
#   https://n2j.ru
#   https://n2j.ru/imagegen/api/worker-result   (полный адрес эндпоинта)
#   [https://n2j.ru](https://n2j.ru/imagegen/api/worker-result)   (ссылка из чата)
#   в кавычках/угловых скобках, с http:// или без схемы («n2j.ru»)
# Путь модуля (/imagegen/api/worker-upload, /imagegen/api/worker-result)
# дописывает воркер, служебный хвост отрезается.
#NJ641_API_BASE=https://n2j.ru
# Токен приёма результата сайтом (X-Worker-Token). Пусто = WORKER_SITE_TOKEN,
# затем WORKER_API_TOKEN (то же значение, что WORKER_API_TOKEN на сайте).
#NJ641_SITE_TOKEN=
# ФАЙЛОВЫЙ РЕЖИМ (рекомендуется, когда воркер и сайт на одной машине):
# воркер пишет картинку прямо в папку сайта, а метаданные — файлом в БД/HTTP.
# Создать каталог и дать права на запись пользователю воркера (mkdir -p …).
#NJ641_MEDIA_DIR=/opt/n2j/public_html/storage/nj641
# Префикс URL файлов (по умолчанию отдаёт сам сайт).
#NJ641_MEDIA_URL_BASE=/imagegen/file
# Сколько секунд даётся на всю доставку результата (страховка от «висит»)
#NJ641_DELIVER_TIMEOUT=90
# Таймауты шагов доставки, сек
#NJ641_PG_WAIT_SEC=10
#NJ641_UPLOAD_TIMEOUT=25
#NJ641_JSON_TIMEOUT=20
# Сколько знаков base64 ещё едет в результате очереди (МБ; 0 — никогда)
#NJ641_INLINE_MAX_MB=1.5
# Как часто рапортовать «модель рисует N с» вокруг внешнего API, сек
#NJ641_TICK_SEC=15
# Таймаут задачи в очереди, сек (генерация дольше — уже «бекенд завис»)
#NJ641_JOB_TIMEOUT=900
# Проверка видеопамяти: 1 — включена, 0 — выключена (настройка «про память»)
NJ641_VRAM_CHECK=1
# Ждать при нехватке памяти (до NJ641_VRAM_WAIT_SEC) вместо немедленной ошибки
NJ641_VRAM_WAIT=1
# Порог свободной видеопамяти, МБ
NJ641_VRAM_MIN_FREE_MB=4096
# Суммарное время ожидания памяти, сек (3–5 минут)
NJ641_VRAM_WAIT_SEC=240
# Пауза между проверками /vram, сек
NJ641_VRAM_POLL_SEC=20
# Таймаут одного запроса генерации, сек
#NJ641_GEN_TIMEOUT=900


# ── nj643_cad: CAD-детали (описание → параметрический код build123d → движок) ──
# Адрес API сайта (воркер сам добавляет /upload, /result).
# Пусто — выводится из базового адреса сайта (NJ641_API_BASE и т.п.).
#NJ643_API_BASE=https://n2j.ru/cad/api
# Токен приёма на сайте (X-Worker-Token). Пусто = WORKER_SITE_TOKEN → WORKER_API_TOKEN.
#NJ643_SITE_TOKEN=
# АДРЕС ВНЕШНЕГО CAD-ДВИЖКА (Headless CAD + KiCad + OpenSCAD).
# Движок исполняет сгенерированный код и собирает STEP/STL/GLB/ракурсы.
# Значение задаётся ТОЛЬКО здесь, на сервере воркера: в коде, в подсказках об
# ошибке и во всём, что уходит на сайт, адрес не появляется (владелец, 27.09.2026).
# В коде адреса по умолчанию нет — без этой переменной сборка честно скажет
# «движок не настроен».
NJ643_CAD_API=
# КЛЮЧ ДВИЖКА (X-API-Key). Ключ нужен ТОЛЬКО воркеру — сайт движок не дёргает.
# Можно задать общим: TOOLFORGE_API_KEY (тогда NJ643_CAD_API_KEY не нужен).
#NJ643_CAD_API_KEY=
# Модель для написания кода («провайдер::модель», пусто — модель по умолчанию)
#NJ643_MODEL=
# Модель для метаинформации: схема параметров, название, назначение (пусто —
# та же модель, что NJ643_MODEL). Код и метаданные пишутся разными прогонами.
#NJ643_META_MODEL=
#NJ643_META=1            # 0 — второй прогон выключен, схему соберём из кода
# Сколько раз просить ИИ починить код после ошибки движка (0–4, по умолчанию 2)
#NJ643_FIX_ATTEMPTS=2
# Таймаут одного запроса к движку, сек (сборка + стресс-тест бывают долгими)
#NJ643_TIMEOUT=600
# Общий бюджет прогона (LLM + все попытки движка), сек — «ряд не висит»
#NJ643_BUDGET=2100
# Потолок размера кода модели, знаков (защита от «полотна»)
#NJ643_MAX_CODE=60000
# Сколько раз стучаться в движок при СЕТЕВОЙ ошибке (DNS/TLS/обрыв), 1–6, по умолчанию 3.
# Живой случай 26.09: соединение закрывалось на рукопожатии TLS, и одна попытка
# выглядела как «движок недоступен», хотя он живой (проверено с другого адреса).
#NJ643_CAD_RETRIES=3
# Пауза между сетевыми повторами, сек (база: 2 → 4 → далее по 6 с)
#NJ643_CAD_RETRY_DELAY=2
# Проверять «движок вообще отвечает» (/health) ДО обращения к ИИ: сетевую беду
# видно сразу, а не после нескольких минут и трёх промптов. 0 — выключить.
#NJ643_PREFLIGHT=1
#NJ643_HEALTH_TIMEOUT=15
# Если адрес воркера не в белом списке движка: прокси, которому движок доверяет
#NJ643_CAD_PROXY=
# Свой сертификат движка (самоподписанный): путь к PEM-файлу
#NJ643_CAD_CA_BUNDLE=
# ВРЕМЕННАЯ мера: не проверять сертификат движка (1 = отключить проверку)
#NJ643_CAD_INSECURE=0

# --- nj645_llmlab: Лаборатория LLM (канал nj645.review) ---
# Адрес API сайта (воркер сам добавляет /worker_result).
#NJ645_LAB_API_BASE=https://n2j.ru/llmlab/api
# Токен приёма на сайте (X-Worker-Token). Пусто = WORKER_SITE_TOKEN → WORKER_API_TOKEN.
#NJ645_LAB_SITE_TOKEN=
# Модель для прогонов промптов («провайдер::модель», пусто — модель по умолчанию)
#NJ645_LAB_MODEL=
# Потолок ответа, токенов (120–4000, по умолчанию 1200)
#NJ645_LAB_MAX_TOKENS=1200

# --- nj646_label: Разбор состава (каналы nj646.label, nj646.study) ---
# Адрес API сайта (воркер сам добавляет /worker_result).
#NJ646_API_BASE=https://n2j.ru/label/api
# Токен приёма на сайте (X-Worker-Token). Пусто = WORKER_SITE_TOKEN → WORKER_API_TOKEN.
#NJ646_SITE_TOKEN=
# Vision-модель для фото этикетки («провайдер::модель», пусто — NJ639_VISION_MODEL
# или модель по умолчанию провайдера).
#NJ646_VISION_MODEL=
# Модель для изучения незнакомых веществ (пусто — модель по умолчанию)
#NJ646_MODEL=
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 1400).
#NJ646_PHOTO_MAX_PX=
# Потолок ответа, токенов (200–4000, по умолчанию 1600). Длинная этикетка
# (косметика: десяток экстрактов масел) в 1600 токенов не влезает — ответ
# обрывается, воркер отдаёт прочитанное с пометкой «проверьте конец списка».
# Если такие обрывы повторяются — поднять до 3000–4000. Оборванный список
# воркер и сам пробует дописать вторым запросом, но каждый запрос тратит время.
#NJ646_MAX_TOKENS=1600
# Двухпроходный режим: сначала модель ПЕРЕПИСЫВАЕТ строки этикетки, потом из
# её текста собирается состав (по возможности — без модели, из блока «Состав:»).
# Так меньше выдумок на мелком шрифте: переписчик ошибается реже, чем модель,
# которую сразу просят собрать состав. 0 — старый одношаговый путь (один запрос).
#NJ646_TRANSCRIBE=1
# Сколько секунд ждать модель (60–1800, по умолчанию 240). ОБЯЗАТЕЛЬНО меньше
# timeout_sec задачи (сайт ставит 360 для фото и 300 для изучения): иначе
# задачу снимут в момент ответа модели и на сайт не уедет ни текст, ни ошибка.
#NJ646_LLM_TIMEOUT=240

# --- Общие ключи VLM-сервисов (nj650_receipt, nj651_meal, nj652_plant) ---
# Одна vision-модель на все сервисы «сними фото — получи разбор»
# («провайдер::модель», пусто — модель по умолчанию у провайдера).
# Свой ключ сервиса (NJ650_VISION_MODEL и т. п.) перебивает этот.
#VLM_MODEL=
# Потолок ответа, токенов (200–8000). Перебивается NJ<ID>_MAX_TOKENS.
#VLM_MAX_TOKENS=1400
# Сколько секунд ждать модель (30–1800). ОБЯЗАТЕЛЬНО меньше timeout_sec задачи
# (сайт ставит 300): иначе воркера снимут в момент ответа и на сайт не уедет
# ни результат, ни внятная ошибка. Перебивается NJ<ID>_LLM_TIMEOUT.
#VLM_TIMEOUT=180
# До какого размера уменьшать фото по большей стороне, пикселей (200–4000).
# Кадр меньше — модель отвечает быстрее и дешевле (токены считаются по
# разрешению). Перебивается ручкой сервиса: NJ650_PHOTO_MAX_PX и т. п.
#VLM_PHOTO_MAX_PX=1400

# --- nj650_receipt: Чек по фото (канал nj650.receipt) ---
# Адрес API сайта (воркер сам добавляет /worker_result).
#NJ650_API_BASE=https://n2j.ru/receipt/api
# Токен приёма на сайте (X-Worker-Token). Пусто = WORKER_SITE_TOKEN → WORKER_API_TOKEN.
#NJ650_SITE_TOKEN=
# Своя vision-модель сервиса (пусто — общая VLM_MODEL).
#NJ650_VISION_MODEL=
# Потолок ответа, токенов (по умолчанию 1600: длинный чек из супермаркета).
#NJ650_MAX_TOKENS=1600
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 1400).
#NJ650_PHOTO_MAX_PX=
# Ожидание модели, секунд (по умолчанию 180).
#NJ650_LLM_TIMEOUT=180

# --- nj651_meal: Калории по фото тарелки (канал nj651.meal) ---
#NJ651_API_BASE=https://n2j.ru/meal/api
#NJ651_SITE_TOKEN=
#NJ651_VISION_MODEL=
#NJ651_MAX_TOKENS=1400
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 1400).
#NJ651_PHOTO_MAX_PX=
#NJ651_LLM_TIMEOUT=180

# --- nj652_plant: Растение по фото (канал nj652.plant) ---
#NJ652_API_BASE=https://n2j.ru/plant/api
#NJ652_SITE_TOKEN=
#NJ652_VISION_MODEL=
#NJ652_MAX_TOKENS=1600
# Размер кадра для модели, px (пусто — общий VLM_PHOTO_MAX_PX, иначе 1400).
#NJ652_PHOTO_MAX_PX=
#NJ652_LLM_TIMEOUT=180

# --- nj653_veclab: Лаборатория векторов (канал nj653.embed) ---
# Мультимодальная эмбеддинг-модель: текст И картинки в одном пространстве
# (qwen3-vl-embedding-2b). Любой ключ EMBEDDING_MM_* можно не задавать — тогда
# берётся общий EMBEDDING_* выше. Отдельные ключи нужны, когда мультимодальная
# модель поднята НЕ там же, где текстовая.
#
# ОСНОВНОЙ ПУТЬ — СВОЙ СЕРВИС ЭМБЕДДИНГОВ (OmniEmbed Service на Qwen3-VL-
# Embedding-2B). Он отдаёт сразу два интерфейса, и воркер понимает оба:
#   POST <адрес>/v1/embeddings  — OpenAI + расширение vLLM: messages=[[…]]
#                                 (диалект omni_messages, основной, пачкой)
#   POST <адрес>/v2/embed       — Cohere Embed v2: inputs=[{content:[…]}]
#                                 (диалект cohere_inputs, резерв)
#   GET  <адрес>/healthz        — паспорт: модель, бэкенд, устройство, loaded
# Опознаётся сервис сам: доктор (python workers/nj653_doctor.py) пишет
# «софт: свой сервис эмбеддингов (OmniEmbed)» и показывает, что в памяти.
#
# ТОКЕН ОБЯЗАТЕЛЕН: сервис ждёт заголовок «Authorization: Bearer oes_…» на
# ВСЕХ путях, включая GET /v1/models и /healthz. Без него — HTTP 401
# «Invalid or missing API key», и доктор так и напишет.
#EMBEDDING_MM_API_URL=https://embed.toolforge.ru/v1
#EMBEDDING_MM_API_KEY=oes_...
#EMBEDDING_MM_MODEL=mradermacher/Qwen3-VL-Embedding-2B-GGUF
# Если воркер ходит наружу через прокси (у чата он свой, у эмбеддингов может
# быть другой): #EMBEDDING_MM_PROXY=http://127.0.0.1:3128
# Формат запроса. Пусто = воркер подбирает сам перебором и запоминает рабочий.
# Для своего сервиса можно зафиксировать и не тратить пробы:
#   omni_messages | cohere_inputs | qwen_objects | oai_content | oai_parts |
#   chat_messages | media_prompt | plain_text
#EMBEDDING_MM_DIALECT=omni_messages
# Картинки сервис берёт сам, поэтому режим описания (caption) не нужен:
#EMBEDDING_MM_FALLBACK=off          # запретить режим описания
# Размерность вектора. У Qwen3-VL-Embedding она матрёшечная: сервис принимает
# 64…2048 и режет вектор на своей стороне (dimensions / output_dimension).
# Значение вне этих границ воркер серверу не шлёт — подрежет у себя.
# ВАЖНО: это же число должно стоять в EMBEDDING_DIMENSIONS при создании
# таблиц nj_653_* — ширина колонки vector(N) задаётся миграцией один раз,
# менять её на ходу нельзя. HNSW-индекс pgvector строит только при N <= 2000,
# поэтому 1024 практичнее, чем полные 2048.
#EMBEDDING_MM_DIMENSIONS=1024
# Сколько ТЕКСТОВ отправлять одним запросом. По умолчанию 1, и это не
# перестраховка: сервер считает пачку одним батчем, и вектор входа зависит от
# соседей по запросу — одна и та же картинка, посланная вдвоём, давала косинус
# 0,77 сама с собой, а один и тот же текст 0,9989. Картинки воркер шлёт по
# одной всегда; поднимать это число стоит, только если доктор написал
# «Пачка не меняет вектор».
#EMBEDDING_MM_BATCH=1
# Ожидание ответа модели, секунд (должно быть МЕНЬШЕ timeout_sec модуля = 240).
#EMBEDDING_MM_TIMEOUT=120
#
# ЗАПАСНЫЕ ПУТИ, если своего сервиса нет.
# 1) llama.cpp с проектором зрения — тоже настоящая мультимодальность:
#   LLAMA_MEDIA_MARKER='<__media__>' llama-server -m Qwen3-VL-Embedding-2B-f16.gguf \
#     --mmproj mmproj-Qwen3-VL-Embedding-2B-f16.gguf \
#     --embedding --pooling last --embd-normalize 2 -c 8192 -ngl auto --port 1237
#   тогда EMBEDDING_MM_API_URL=http://127.0.0.1:1237/v1 (чат остаётся на LM Studio).
# 2) LM Studio мультимодальные эмбеддинги НЕ даёт: он грузит модель по ТИПУ
#    эндпоинта (/v1/embeddings — только type=embeddings из GET /api/v0/models),
#    а GGUF Qwen3-VL-Embedding числится как llm, и «lms load» не помогает.
#    Остаётся режим описания: картинку опишет vision-модель через чат, вектор
#    даст текстовая эмбеддинг-модель того же сервера (связь текст↔картинка
#    получается слабее, чем у настоящей мультимодальной модели).
#EMBEDDING_MM_CAPTION_MODEL=        # чем описывать (пусто → NJ653_VISION_MODEL → VLM_MODEL)
#EMBEDDING_TEXT_MODEL=              # чем эмбеддить описание (пусто → первая embeddings-модель)
#
# Подключение к токену/прокси работает как у чата: если адрес эмбеддингов ведёт
# на тот же сервер, что LLM-провайдер (<ИМЯ>_API_URL выше), воркер берёт оттуда
# токен и прокси. Можно указать провайдера прямо в имени модели:
#   EMBEDDING_MODEL=toolforge::qwen3-vl-embedding-2b
#
# Адрес приёмки сайта и токен (= WORKER_API_TOKEN в .env САЙТА).
#NJ653_API_BASE=https://n2j.ru/veclab/api
#NJ653_SITE_TOKEN=

# ---------------------------------------------------------------------------
# NJ-654 «Похожие картинки» (/similar): банк изображений и поиск по смыслу
# ---------------------------------------------------------------------------
# Модель та же, что у nj653 (EMBEDDING_MM_* выше) — отдельных ключей не нужно.
# Канал очереди: nj654.embed. Воркер считает векторы банка и запросов, сам
# поиск по векторам делает сайт.
#
# Адрес приёмки сайта и токен (= WORKER_API_TOKEN в .env САЙТА).
#NJ654_API_BASE=https://n2j.ru/similar/api
#NJ654_SITE_TOKEN=

# --- nj661_airadar: ИИ-радар (воркер nj661.airadar) -------------------------
# Прогресс ИИ → база знаний (факты) → отчёт и письмо владельцу.
# Источники: HuggingFace API, OpenRouter /api/v1/models, RSS-ленты ИИ-гигантов,
# ddgs-поиск («утка»), lmarena.ai/leaderboard.
# Адрес приёмки и токен НЕ обязательны: канал берёт общие NJ120_API_BASE и
# WORKER_SITE_TOKEN (см. верх файла) и сам подставляет /airadar/api.
# Раскомментируйте, только если канал живёт на другом сайте.
#NJ661_AIRADAR_API_BASE=https://n2j.ru/airadar/api
#NJ661_AIRADAR_SITE_TOKEN=
NJ661_AIRADAR_MODEL=
# Примерный контекст модели (токенов): 16000 для локальной Gemma на 16K-карте.
# Ограничивает весь запрос вместе с базой знаний; пусто = 16000.
# BATCH — верхняя граница, при 3000 токенах ответа не больше 3 материалов.
# PAGE_CAP ограничивает текст страницы; общий бюджет может дополнительно его обрезать.
NJ661_AIRADAR_CONTEXT=
#NJ661_AIRADAR_BATCH=4
#NJ661_AIRADAR_PAGE_CAP=2000
# Доп. ddgs-запросы и RSS-ленты («|»-список; базовые зашиты в коде).
#NJ661_AIRADAR_QUERIES=агентные фреймворки open source | ИИ закон ограничения
#NJ661_AIRADAR_RSS=https://example.com/feed.xml
# Сколько страниц читать полностью и пауза между запросами (сек).
NJ661_AIRADAR_MAX_PAGES=12
NJ661_AIRADAR_DELAY=1.5

# --- erp222_forge: Кузница систем (воркер erp222.forge) --------------------
# Цикл синтеза: группа LLM-ролей (Архитектор → Инженер → Аналитик → Критик →
# Редактор) выпускает артефакты — спецификацию, схему данных, контракт API,
# алгоритм, промпт, план проверки, риски, метрики, оценку, оффер. Сайт ставит
# цикл в очередь (nj120), страница /forge показывает живой ход.
# Адрес приёмки и токен НЕ обязательны: канал берёт общие NJ120_API_BASE и
# WORKER_SITE_TOKEN (см. верх файла) и сам подставляет /forge/api.
# Раскомментируйте, только если канал живёт на другом сайте.
#ERP222_FORGE_API_BASE=https://n2j.ru/forge/api
#ERP222_FORGE_SITE_TOKEN=
# «провайдер::модель» для шагов синтеза; пусто = модель по умолчанию воркера.
ERP222_FORGE_MODEL=
# Примерный контекст модели в токенах: из него считаются срезы промпта (уже
# выпущенное, база знаний) и бюджет ответа шага. Пусто = 32000.
ERP222_FORGE_CONTEXT=
# Бюджет ответа шага в токенах (документ 10-14 тысяч знаков ≈ 4-5 тысяч токенов).
# Пусто = контекст/4, не меньше 1400 и не больше 6000.
#ERP222_FORGE_MAX_TOKENS=2600
# Доработка документа по проверке «документ или пересказ»: включена по
# умолчанию, не больше одной на шаг. 0 — выключить (быстрее, но слабее).
#ERP222_FORGE_POLISH=1
# Секунд на весь цикл и на один вызов модели.
#ERP222_FORGE_BUDGET=2400
#ERP222_FORGE_STEP_TIMEOUT=420

# --- nj662_dialog: Диалог двух ИИ (воркеры nj662.dialog и nj662.quick) ------
# Один обмен = реплика первого агента + реплика второго (+ сводка и, если
# разрешено, поиск в интернете). Ход ведёт САЙТ: после приёма обмена он сам
# ставит следующий (канал nj662.dialog), поэтому закрытая вкладка браузера
# диалог не останавливает.
# Адрес приёмки и токен НЕ обязательны: канал берёт общие NJ120_API_BASE и
# WORKER_SITE_TOKEN (см. верх файла) и сам подставляет /dialog/api.
# Раскомментируйте, только если канал живёт на другом сайте.
#NJ662_API_BASE=https://n2j.ru/dialog/api
#NJ662_SITE_TOKEN=
# «провайдер::модель» для служебных вызовов (поисковый запрос, сводка) и для
# подбора участников; пусто = модель воркера по умолчанию. У реплик модель своя:
# она берётся из настроек диалога и уезжает в задаче.
NJ662_MODEL=
# Поиск в интернете («утка го»): 0 — не искать вовсе, даже если у диалога есть
# бюджет (аварийный выключатель канала). Диалог без этого живёт на материалах.
#NJ662_SEARCH=1
# Секунд на один поиск (выдача + чтение страниц) и сколько находок брать.
#NJ662_SEARCH_TIMEOUT=45
# Примерный контекст модели в токенах: из него считается, сколько текста
# материалов и найденных страниц уходит в подсказку. Пусто = 8000.
#NJ662_CONTEXT=8000

# --- nj666_multivoice: многоголосая озвучка книги (nj666.plan / nj666.voice) -
# Книгу разбирает воркер; длинный синтез тоже (OmniVoice, как /voice). Адрес
# приёмки и токен НЕ обязательны: канал берёт общие NJ120_API_BASE и
# WORKER_SITE_TOKEN и сам подставляет /multivoice/w. Раскомментируйте, только
# если канал живёт на другом сайте.
#NJ666_API_BASE=https://n2j.ru/multivoice/w
#NJ666_SITE_TOKEN=
# «провайдер::модель» для разбора книги на реплики. Пусто = модель воркера.
NJ666_MODEL=
# Примерный контекст модели в токенах: окно текста ужимается под него.
#NJ666_CONTEXT=16000
# «Утка го»: искать состав действующих лиц известной книги. 0 — запретить.
#NJ666_SEARCH=1
#NJ666_SEARCH_TIMEOUT=45
# Синтез OmniVoice v1: те же адрес и ключ, что NJ665_* у сайта. Без них
# озвучка отказывается сразу, а не висит на nginx.
#NJ665_API_URL=https://voice.example.ru
#NJ665_API_KEY=
# Модель синтеза. Пусто = k2-fsa/omnivoice (поле в API обязательное).
#NJ665_MODEL=
# Секунд на один кусок синтеза (до NJ665_MAX_CHARS знаков). Дефолт 600:
# 120 с с сайта для превью мало на главу. NJ666_SYNTH_TIMEOUT перекрывает.
#NJ665_TIMEOUT=600
#NJ666_SYNTH_TIMEOUT=600

# --- nj667_graph3d: Графовый 3D-конструктор (nj667.generate/inpaint/summary/embed;
#     nj667.moderate ставит сайт только при NJ667_PREMODERATE=1 в корневом .env)
# Описание → пространственный граф. Воркер ходит на сайт за контекстом и
# сдаёт граф обратно; в базу NJ667 сам не ходит. Адрес приёмки и токен НЕ
# обязательны: канал берёт общие NJ120_API_BASE и WORKER_SITE_TOKEN и сам
# подставляет /graph3d/w. Раскомментируйте, только если канал живёт на
# другом сайте.
#NJ667_API_BASE=https://n2j.ru/graph3d/w
#NJ667_SITE_TOKEN=
# «провайдер::модель» для сборки и достройки графа. Пусто = модель воркера.
NJ667_MODEL=
# Дешёвая модель для названия, описания, тегов, идей, саммари и пре-модерации.
# Пусто — та же, что NJ667_MODEL.
#NJ667_LIGHT_MODEL=
# Сколько похожих графов из каталога класть в подсказку (few-shot RAG).
#NJ667_FEW_SHOT=2
# Длинная сторона кадра для vision, px. Если фото больше — уменьшаем.
# Пусто — общий VLM_PHOTO_MAX_PX, иначе 512. Админка /graph3d/settings
# кладёт свой размер в контекст сайта; эта ручка — запасной дефолт воркера.
#NJ667_PHOTO_MAX_PX=512
# Бюджет символов на граф в подсказке саммари и лимит ответа модели.
#NJ667_CONTEXT=8000
#NJ667_MAX_TOKENS=4000
#NJ667_MAX_SUMMARY=4000
#NJ667_LLM_TIMEOUT=300
# Эмбеддинги канала nj667.embed — общие EMBEDDING_MM_* (см. выше). Отдельных
# ключей у модуля нет.
# --- nj667.build: .scad сборки → STL (OpenSCAD, без модели) -------------------
# Движок и BOSL2 ищутся там же, где у nj570 (NJ570_OPENSCAD_BIN / LIB, см.
# выше); NJ667_OPENSCAD_BIN нужен, только если для сборки указан другой бинарь.
# Пусто — воркер честно вернёт no_engine, и страница предложит собрать .scad самому.
# Версию openscad подбирать не нужно: воркер спрашивает --help у бинаря и зовёт
# только те флаги, которые он знает (--export-format/--hardwarnings — из 2021.01).
# Пол при этом 2019.05: модель говорит на let()/norm(); древний бинарь воркер
# отвергает сам (no_engine) и отдаёт человеку .scad.
#NJ667_OPENSCAD_BIN=
# Секунды на один рендер. Купол из сотни узлов считается минутами; держите в
# ладу с NJ667_BUILD_TIMEOUT на сайте (очередь убьёт задачу раньше).
#NJ667_BUILD_TIMEOUT=900

# --- nj668_draw2d: Плоские иллюстрации (nj668.generate)
# Описание темы → векторная сцена (прямые, Безье, заливки). Воркер ходит на
# сайт за контекстом и сдаёт сцену обратно; в базу NJ668 сам не ходит.
# Адрес приёмки и токен НЕ обязательны: канал берёт общие NJ120_API_BASE и
# WORKER_SITE_TOKEN и сам подставляет /draw2d/w.
#NJ668_API_BASE=https://n2j.ru/draw2d/w
#NJ668_SITE_TOKEN=
# «провайдер::модель» для сборки сцены. Пусто = модель воркера.
NJ668_MODEL=
# Дешёвая модель для идей. Пусто — та же, что NJ668_MODEL.
#NJ668_LIGHT_MODEL=
# Длинная сторона кадра для vision, px. Пусто — VLM_PHOTO_MAX_PX, иначе 512.
#NJ668_PHOTO_MAX_PX=512
#NJ668_MAX_TOKENS=4000
#NJ668_LLM_TIMEOUT=300
#NJ668_IDEAS_MAX_TOKENS=2500

# --- nj597_notifications: настройка на стороне САЙТА, воркер эти ключи не читает ---
# Боты и SMTP отправляются PHP-центром, не Python-воркером. Значения задать в .env сайта.
#NJ597_NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
#NJ597_NOTIFICATIONS_TELEGRAM_BOT_NICK=
#NJ597_NOTIFICATIONS_MAX_BOT_TOKEN=
#NJ597_NOTIFICATIONS_MAX_BOT_NICK=
#NJ597_NOTIFICATIONS_MAX_BUSINESS_KEY=
#NJ597_NOTIFICATIONS_MAX_BUSINESS_ENDPOINT=
# См. application/modules/nj597_notifications/README.md: настройка и проверка.

# --- nj661_airadar: рассуждающие модели (локальная Qwen3.5 и подобные) ---
# 15.10.2026 прогон #10 упал: 2953 токена из 3000 ушли в reasoning_content,
# JSON анализа оборвался на середине, «ни одного материала». Радар смотрит на
# usage: при обрыве по лимиту расширяет ответ и мельчит пачки, при размышлениях
# ещё и глушит их (chat_template_kwargs.enable_thinking / reasoning_effort;
# сервер, который полей не знает, отвечает 400 — воркер повторяет без них).
# Запас ответа, токенов. Пусто — из конфига сайта (limits.out_tokens, 8000).
#NJ661_AIRADAR_OUT_TOKENS=8000
# auto (по умолчанию) | 0 — не рассуждать | 1 — не глушить размышления.
#NJ661_AIRADAR_THINK=auto
# Если сервер не принимает большой max_tokens, воркер сам вернётся к базовым 3000
# (stats.output_capped_by_provider) — тогда есть смысл задать THINK=0.
# Сколько пачек ПОДРЯД можно провалить, прежде чем отложить остаток очереди.
# По умолчанию 5; неразобранный JSON серию не растит (это не отказ провайдера).
#NJ661_AIRADAR_MAX_FAILS=5

# --- 3D-детали (nj669, /solid3d, канал nj669.generate) ----------------------
# Своя база — полный API-путь, напр. https://n2j.ru/solid3d/w;
# пусто = NJ120_API_BASE (корень сайта) + /solid3d/w.
NJ669_API_BASE=
# Должен совпадать с WORKER_API_TOKEN сайта; пусто = общий WORKER_SITE_TOKEN.
NJ669_SITE_TOKEN=
# Провайдер::модель для кода; пусто = дефолт LLM воркера.
NJ669_MODEL=
# Модель с поддержкой изображений; пусто = общая VLM_MODEL.
NJ669_VISION_MODEL=
# Только воркер: путь к OpenSCAD; пусто = NJ570_OPENSCAD_BIN/автопоиск/PATH.
# Встроенные примитивы: BOSL2 не требуется. Нужны headless OpenGL/Xvfb и Pillow.
NJ669_OPENSCAD_BIN=
# Квоты/модели/0–2 починки — /solid3d/settings, отдельные квоты — /solid3d/limits.
# Приватные файлы: storage/nj669; включить в DEPLOY_MODULE_STORAGE, если задан свой список.
# Недорогая текстовая модель для идей и карточек (провайдер::модель).
NJ669_LIGHT_MODEL=

# --- nj670_processhub: бизнес-процессы (/process) ----------------------------
# Сайт за контекстом и сдаёт схему/аудит/документ обратно; в PostgreSQL воркер
# не ходит. Пульс присутствия (/process/w/ping) идёт раз в минуту — без него
# сайт считает простаивающий воркер выключенным и собирает схему по правилам.
#NJ670_API_BASE=https://n2j.ru/process/w
#NJ670_SITE_TOKEN=
# Пульс: выключить (0) или изменить период в секундах (минимум 5, по умолчанию 60).
#NJ670_PING=1
#NJ670_PING_INTERVAL=60
# «провайдер::модель» для синтеза BPMN и AI-аудита. Пусто = модель воркера.
NJ670_MODEL=
# Дешёвая модель для AI-дополнения выбранного узла. Пусто = NJ670_MODEL.
NJ670_LIGHT_MODEL=
# Распознавание речи: OpenAI-совместимый /audio/transcriptions.
# Без NJ670_ASR_URL аудио-источник отклоняется с понятной ошибкой.
#NJ670_ASR_URL=
#NJ670_ASR_KEY=
#NJ670_ASR_MODEL=whisper-1
# Для PDF с текстовым слоем: pypdf (или PyPDF2). Без него PDF принимается
# только как скан — через vision-модель.

# --- nj671_embedbench: стенд эмбеддингов (/embedbench, канал nj671.bench) -----
# Сайт за контекстом и сдаёт отчёт обратно; в PostgreSQL воркер не ходит.
# Адрес приёмки: пусто = NJ120_API_BASE (корень сайта) + /embedbench/api.
NJ671_API_BASE=
# Должен совпадать с WORKER_API_TOKEN сайта; пусто = общий WORKER_SITE_TOKEN.
NJ671_SITE_TOKEN=
# Своих адресов эмбеддингов у стенда НЕТ: он меряет ровно те два пути, что уже
# настроены для платформы, и не подменяет один другим.
#   текстовый        EMBEDDING_API_URL + EMBEDDING_MODEL
#   мультимодальный  EMBEDDING_MM_API_URL + EMBEDDING_MM_MODEL (+ EMBEDDING_MM_DIALECT)
# Если EMBEDDING_MM_API_URL пуст, путь честно помечается «не настроен», а не
# берёт адрес текстового: иначе стенд сравнивал бы сервер сам с собой.
# Проба «картинка ↔ слова» требует Pillow (workers/requirements.txt) и хотя бы
# один тестовый образ; без них шаг пропускается с пометкой в отчёте.

# --- nj672_aiscan: сканер безопасности ИИ-моделей (/aiscan, канал nj672.scan) ---
# Воркер ходит атакующими промптами и нагрузкой к цели аудита и сдаёт отчёт
# сайту; в PostgreSQL не ходит. Адрес приёмки: пусто = NJ120_API_BASE + /aiscan/api.
NJ672_API_BASE=
# Должен совпадать с WORKER_API_TOKEN сайта; пусто = общий WORKER_SITE_TOKEN.
NJ672_SITE_TOKEN=
# Пресет цели «preset» — правильный путь для боевых эндпоинтов: ключ не
# покидает машину воркера и не попадает ни в формы сайта, ни в отчёты.
#NJ672_TARGET_URL=https://api.example.com/v1
#NJ672_TARGET_MODEL=
#NJ672_TARGET_KEY=
# Разрешить цели в loopback/private-сетях (локальный vLLM/LM Studio, туннель
# до HuggingFace). По умолчанию 0: SSRF-сторож отклоняет приватные адреса;
# облачные metadata (169.254.169.254 и пр.) запрещены при любом значении.
#NJ672_ALLOW_PRIVATE=0
# Жёсткий потолок конкурентности стресс-теста (профиль full режется здесь)
# и общего числа нагрузочных запросов на прогон — анти-DoS ограничители.
#NJ672_MAX_CONCURRENCY=100
#NJ672_MAX_LOAD_REQUESTS=600
# Таймаут одного запроса к цели и общий бюджет времени прогона, секунды.
#NJ672_REQ_TIMEOUT_SEC=60
#NJ672_BUDGET_SEC=1500
# Судья-модель для спорных (WARN) находок: «провайдер::модель»; пусто —
# провайдер воркера по умолчанию. Судьёй бывает только своя модель, не цель.
NJ672_JUDGE_MODEL=
# Сколько спорных находок максимум отдавать судье за прогон.
#NJ672_JUDGE_MAX=12

# --- MCP Hub (nj676, /mcphub, канал nj676.discover) --------------------------
# Автосборка каталога: GitHub (теги mcp / mcp-server), поиск в интернете,
# README → пакет и удалённый адрес, LLM-описания, живая проверка tools/list.
# Сайт за приёмкой карточек; в PostgreSQL воркер не ходит.
# Адрес приёмки: пусто = NJ120_API_BASE (корень сайта) + /mcphub/api.
NJ676_API_BASE=
# Должен совпадать с WORKER_API_TOKEN сайта; пусто = общий WORKER_SITE_TOKEN.
NJ676_SITE_TOKEN=
# Токен GitHub: без него 60 запросов/час (каталог соберётся, но медленно).
# Можно переиспользовать NJ593_GITHUB_TOKEN — воркер посмотрит и его.
NJ676_GITHUB_TOKEN=
# Модель для русских описаний и категорий («провайдер::модель»).
# Пусто = модель воркера; без модели карточки соберутся по фактам GitHub.
NJ676_MODEL=
# Минимум звёзд для попадания в каталог (по умолчанию 10; для тематики — 3).
#NJ676_MIN_STARS=10
# Сколько карточек брать за прогон (потолок 30) и сколько символов README читать.
#NJ676_MAX_ITEMS=30
#NJ676_README_CAP=4000
# Сколько проектов отдавать модели за один вызов (1–10).
#NJ676_LLM_BATCH=5
# 1 — проверять удалённые серверы вызовом initialize + tools/list (живой статус).
#NJ676_PROBE=1
#NJ676_PROBE_TIMEOUT=8
# 1 — добирать проекты поиском DuckDuckGo (в т.ч. без тегов mcp).
#NJ676_DDG=1

# Русские названия и описания карточек (канал nj676.translate).
# Сколько карточек за прогон (1–100) и сколько в одном запросе к модели (1–10).
#NJ676_TRANSLATE_LIMIT=20
#NJ676_TRANSLATE_BATCH=5
# Модель перевода; пусто = NJ676_MODEL.
#NJ676_TRANSLATE_MODEL=

# ИИ-анализ каталога (канал nj676.analysis): срез данных + модель + отчёт в
# админке («что реально работает и чего не хватает»). Модель по умолчанию —
# NJ676_MODEL, бюджет ответа — 4000 токенов.
#NJ676_ANALYSIS_MODEL=
#NJ676_ANALYSIS_TOKENS=4000

# Импорт официального реестра MCP (канал nj676.registry): server.json без LLM.
# Сколько записей брать за прогон (10–20000) и размер страницы.
#NJ676_REGISTRY_MAX=1500
#NJ676_REGISTRY_PAGE=100
# Пауза между страницами, секунды (бережём чужой API).
#NJ676_REGISTRY_DELAY=0.15
# Другой адрес реестра (staging/локальный) — по умолчанию официальный.
#NJ676_REGISTRY_URL=https://registry.modelcontextprotocol.io
