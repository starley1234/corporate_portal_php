# Один хост с PHP: оставьте файл пустым; воркер возьмёт адрес, токен и БД из ../.env.
# Не оставляйте скопированные ранее localhost:8080, если PHP не слушает этот порт.
# Приоритет: systemd/окружение > workers/.env > корневой .env.

# Пример для отдельного хоста без доступа к БД (раскомментируйте и задайте токен):
# APP_URL=https://portal.toolforge.ru
# WORKER_QUEUE_MODE=http
# WORKER_API_TOKEN=один_и_тот_же_токен_что_на_PHP

# Если отдельный воркер подключается к PostgreSQL напрямую:
# WORKER_QUEUE_MODE=pg
# WORKER_PG_DSN=postgresql://prx:ПАРОЛЬ@db.example.test:5432/prx
# APP_URL и WORKER_API_TOKEN всё равно нужны: PDF и результаты идут через PHP.

# Рабочие переопределения при необходимости:
# WORKER_CHANNELS=echo,document.extract,doc.normalize,doc.analyze
# PRX120_API_BASE=https://portal.toolforge.ru
# PRX395_*: копируйте настройки лимитов из корневого .env.example в корневой .env.
# Записи здесь переопределяют корневой .env только для воркера; PHP их не видит.
# OCR_PROVIDER=tesseract
