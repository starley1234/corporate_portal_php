# PRX: окружение отдельного процесса воркера. Секреты сайта здесь не наследуются.
WORKER_QUEUE_MODE=pg
WORKER_PG_DSN=postgres://prx:prx@127.0.0.1:5432/prx
PRX120_API_URL=http://localhost:8080/prx120/api
WORKER_API_TOKEN=
WORKER_SITE_TOKEN=
PRX120_API_BASE=http://localhost:8080
PRX115_API_BASE=http://localhost:8080/prx115/api
PRX115_SITE_TOKEN=
WORKER_NAME=worker-1
WORKER_CHANNELS=echo,embeddings.index,llm.summarize,semantic.index,doc.normalize,doc.analyze,doc.draft
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5
WORKER_LOG_LEVEL=INFO
TOOLFORGE_API_URL=
TOOLFORGE_API_KEY=
TOOLFORGE_DEFAULT_MODEL=
LM_API_TOKEN=
LLM_DEFAULT_PROVIDER=toolforge
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# Документооборот: локальная модель для doc.analyze/doc.draft.
PRX392_MODEL=local::openai/gpt-oss-20b
PRX394_MODEL=
# PRX390_API_BASE=http://localhost:8080/prx390/api
# PRX392_API_BASE=http://localhost:8080/prx392/api
# PRX394_API_BASE=http://localhost:8080/prx394/api
PRX390_SITE_TOKEN=
PRX392_SITE_TOKEN=
PRX393_SITE_TOKEN=
PRX394_SITE_TOKEN=

# OCR для doc.normalize: tesseract — локально/dev, remote — внешний сервис.
# Remote получает PDF (multipart, поле file) и отвечает JSON:
# {"text": "...", "pages": 3, "engine": "docling", "confidence": 0.93}
OCR_PROVIDER=tesseract
OCR_SERVICE_URL=
OCR_TIMEOUT=120
# Remote OCR: токен и параметры парсинга. Заголовок по умолчанию —
# Authorization: Bearer; OCR_AUTH_HEADER_NAME=X-API-Key отправляет сырой ключ.
OCR_API_KEY=
OCR_AUTH_HEADER_NAME=
# JSON-объекты. OCR_EXTRA_PARAMS уходит в multipart data= (output_format, lang…),
# OCR_EXTRA_HEADERS добавляет произвольные HTTP-заголовки.
OCR_EXTRA_PARAMS={}
OCR_EXTRA_HEADERS={}
