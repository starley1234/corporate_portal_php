# =============================================================================
# N2J — шаблон окружения сайта. Рабочий .env создаёт bin/setup.sh.
# .env в git НЕ коммитится; переменные окружения сервера главнее (.env.php).
# Воркеры настраиваются отдельно: workers/.env.example.
# =============================================================================

# --- Приложение ---------------------------------------------------------------
KOHANA_ENV=development          # development | production | staging
STRICT_DEPRECATIONS=0           # 1 = депрекейшены PHP 8.4 рвут запрос
APP_URL=http://localhost:8080   # публичный адрес (письма, absolute_url)
APP_PORT=8080                   # порт nginx в docker compose

# --- PostgreSQL ---------------------------------------------------------------
DB_DEFAULT_HOST=127.0.0.1       # в docker compose — postgres
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=n2j
DB_DEFAULT_USER=n2j
DB_DEFAULT_PASS=n2j
DB_DEFAULT_SCHEMA=public

# --- Безопасность (секреты генерирует bin/setup.sh) ---------------------------
COOKIE_SALT=
AUTH_HASH_KEY=
MIGRATIONS_TOKEN=               # HTTP-миграции /migrate_pg; пусто = только в development

# --- Администратор (make seed) ------------------------------------------------
ADMIN_EMAIL=admin@n2j.ru
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- LLM-провайдеры (формат моделей везде «провайдер::модель») ----------------
# Сайт: application/config/llm.php — «local::» читает TOOLFORGE_*,
# «openrouter::» читает OPENROUTER_*; воркеры — workers/.env.example.
TOOLFORGE_API_URL=http://127.0.0.1:1234/v1/
TOOLFORGE_API_KEY=
# LM Studio 0.3.x+ требует Bearer-токен. Если он не задан, каждый запрос получает
# 401 «An LM Studio API token is required…». Токен берётся из LM_API_TOKEN
# (имя из документации LM Studio) как фолбэк для локальных провайдеров.
LM_API_TOKEN=
#TOOLFORGE_DEFAULT_MODEL=       # пусто = значение в config/llm.php
#TOOLFORGE_PROXY=

OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
#OPENROUTER_DEFAULT_MODEL=      # пусто = значение в config/llm.php
#OPENROUTER_PROXY=              # пусто = значение в config/llm.php

# --- Эмбеддинги (ОТДЕЛЬНЫЙ эндпоинт, OpenAI-совместимый /v1/embeddings) -------
EMBEDDING_API_URL=http://127.0.0.1:1235/v1/
EMBEDDING_API_KEY=
# Только текстовая эмбеддинг-модель: /v1/embeddings у LM Studio и большинства
# OpenAI-совместимых серверов обслуживает модели типа embeddings. Имя
# мультимодальной модели (qwen3-vl-embedding-*) здесь даёт HTTP 400 «No models
# loaded» — она подключается отдельным сервисом (EMBEDDING_MM_API_URL у воркера).
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
# Мультимодальная модель (nj653_veclab, /veclab): её адрес и ключи живут в
# workers/.env (EMBEDDING_MM_*) — векторы считает воркер. Сайту нужна только
# размерность: миграция nj653 создаёт колонку vector(N) по EMBEDDING_MM_DIMENSIONS
# (а если её нет — по EMBEDDING_DIMENSIONS выше, иначе 2048). Ширина задаётся
# ОДИН раз при создании таблицы: менять модель на другую размерность = новая миграция.
#EMBEDDING_MM_DIMENSIONS=2048

# --- MCP Hub (nj676): смысловой поиск -----------------------------------------
# Каталог индексирует карточки векторами того же сервера EMBEDDING_API_URL
# (хранилище — nj115_semantic, коллекция nj676_mcphub). Поиск объединяет смысл
# и слова: «отправить письмо» находит почтовый сервер, а не набор иконок со
# словом email. Без EMBEDDING_API_URL всё работает по словам — как раньше.
#NJ676_SEMANTIC=1              # 0 — выключить смысловой поиск совсем
#NJ676_OK_WINDOW_MIN=30        # сколько минут успешный вызов «оправдывает» сервер
#NJ676_STALE_DAYS=7            # после скольких дней проверка считается старой

# --- Очередь nj120 и воркеры ---------------------------------------------------
WORKER_API_TOKEN=               # HTTP-API /nj120/api; пусто = воркеры через PG напрямую
SITE_UPDATE_TOKEN=              # пинок обновления: GET /update/kick/<токен>; кнопка админа /nj100/update
WORKER_PG_DSN=postgres://n2j:n2j@127.0.0.1:5432/n2j   # в docker: host=postgres
WORKER_NAME=worker-1
WORKER_CHANNELS=                # через запятую; пусто = все
# Модули nj570 (3D) и nj580 (документы): воркер пишет файлы через
# /3d/api/* и /docs/api/* с этим же WORKER_API_TOKEN (см. workers/.env.example).

# Доставка результатов воркером на сайт (режим http: воркеры на своём сервере).
# Токен один — WORKER_API_TOKEN сайта; в режиме pg он у воркера пуст, поэтому
# доставка настраивается отдельной переменной, тем же значением:
WORKER_SITE_TOKEN=              # = WORKER_API_TOKEN выше
NJ120_API_BASE=https://n2j.ru   # КОРЕНЬ сайта (не /nj120/api) — общий запасной адрес
# Поиск по смыслу (nj115_semantic, канал semantic.index): в режиме http векторы
# пишет САЙТ, поэтому воркеру нужны адрес API модуля и токен. Без них задача
# падает с «Векторы не дошли до сайта» (в режиме pg они не нужны — воркер
# пишет векторы в базу сам). Годится и корень сайта вместо /nj115/api.
NJ115_API_BASE=https://n2j.ru/nj115/api
NJ115_SITE_TOKEN=               # пусто = WORKER_SITE_TOKEN
# Остальные каналы (nj591/nj592/nj593/nj598/nj600/nj605/nj606/nj607/nj609/
# nj610/nj612/nj613/nj639/nj640/nj642/nj643) настраиваются так же: своя пара
# <КАНАЛ>_API_BASE + <КАНАЛ>_SITE_TOKEN; полный список с путями — в
# workers/.env.example (разделы «--- njXXX_...»).

# --- MCP-хаб (инструменты для ИИ-агентов, /mcp/api/rpc) ------------------------
MCP_TOKEN=

# --- Почта (уведомления nj597, symfony/mailer) ---------------------------------
# DSN транспорта: smtp://логин:пароль@smtp.example.com:465 (или 587 + ?encryption=tls,
# для Яндекс: smtp://логин:пароль@smtp.yandex.ru:465).
# Альтернативы: sendmail://default (локальный MTA), null://null — письма выключены.
EMAIL_DSN=
EMAIL_FROM=no-reply@n2j.ru
EMAIL_FROM_NAME=N2J.ru
# 0 — центр уведомлений не шлёт письма вовсе (колокольчик работает всегда)
# NJ600: дни хранения СЫРЫХ событий предпочтений (nj_600_events); суммаризация не чистится
#NJ600_RAW_TTL_DAYS=21

# NJ601 Robokassa (приём платежей; результат-URL в кабинете: https://n2j.ru/billing/result)
#NJ601_ROBOKASSA_LOGIN=
#NJ601_ROBOKASSA_PASSWORD1=
#NJ601_ROBOKASSA_PASSWORD2=
#NJ601_ROBOKASSA_IS_TEST=1
NJ597_EMAIL_ENABLED=1

# --- Вход через Яндекс (nj659_yandexauth) ----------------------------------------
# OAuth-приложение создаётся на oauth.yandex.ru; там же укажите redirect URI:
#   https://<домен>/auth/yandex/callback
# ВАЖНО: redirect_uri должен совпадать с Callback URL приложения НА oauth.yandex.ru
# ПОСИМВОЛЬНО (схема, домен, путь). Несовпадение = «redirect_uri не совпадает
# с Callback URL, указанным при регистрации приложения» — Яндекс откажет.
# Пустое значение тоже работает: модуль сам построит https://<текущий-хост>/auth/yandex/callback.
# Пока ID/секрет пусты, кнопка «Войти через Яндекс» на странице входа
# не показывается, а /auth/yandex отвечает страницей-подсказкой.
#YANDEX_OAUTH_CLIENT_ID=
#YANDEX_OAUTH_CLIENT_SECRET=
#YANDEX_OAUTH_REDIRECT_URI=

# --- Загрузчик .env --------------------------------------------------------------
# 28.09.2026 отсюда убраны MAIL_USERNAME/MAIL_PASSWORD (модуль email/SwiftMailer
# удалён — его никто не вызывал, а сам SwiftMailer в зависимостях отсутствовал).
# Почта платформы настраивается через EMAIL_DSN выше.
# 06.10.2026 возвращены YANDEX_OAUTH_* — вход через Яндекс снова работает
# (модуль nj659_yandexauth, server-side flow, redirect на /auth/yandex/callback).
# Маркер загрузчика .env (application/env.php): имена переменных через запятую,
# которые считаются «файловыми», а не серверными. Обычно не нужен.
#N2J_ENV_FILE_VARS=

# --- nj602_content: контент-конвейер (автостатьи с модерацией) -------------------
# 1 = публиковать без модерации (ПОКА не включать — сначала человек)
NJ602_AUTO_PUBLISH=0

# --- nj603_kicker: «Пиналка» (один cron раз в 10 минут на все модули) ------------
# токен HTTP-эндпоинта /nj603/kick/<token> (альтернатива cron-строке с CLI)
NJ603_KICK_TOKEN=

# --- Производительность горячих запросов аккаунта и предпочтений ----------------
# Аварийный DDL-bootstrap; штатно схема ставится миграциями и значение оставляют 0.
NJ599_SCHEMA_AUTOCREATE=0
NJ600_SCHEMA_AUTOCREATE=0
# Минимальный интервал записи телеметрии nj600 с одного браузера, секунд.
NJ600_TRACK_MIN_INTERVAL=60

# --- Горячие API расписаний: схема только через миграции ------------------------
NJ593_SCHEMA_AUTOCREATE=0
NJ602_SCHEMA_AUTOCREATE=0
NJ603_SCHEMA_AUTOCREATE=0
# Таймаут LLM контент-конвейера, секунд.
NJ602_LLM_TIMEOUT=240

# --- nj605_radar: Радар заказов (воркер: ddgs + LLM + отправка находок) ---
NJ605_RADAR_API_BASE=http://127.0.0.1/radar/api
NJ605_RADAR_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ605_RADAR_MAX_SITES=4
NJ605_RADAR_MIN_INTERVAL=55

# --- nj606_leads: Поток заказчиков (воркер: поиск компаний под оффер) ---
NJ606_LEADS_API_BASE=http://127.0.0.1/leads/api
NJ606_LEADS_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ606_LEADS_MAX_SITES=6
NJ606_LEADS_SEARCH_DELAY=2.0

# --- nj607_industry: Карта отрасли (воркер: авто-отчёт по рынку) ---
NJ607_INDUSTRY_API_BASE=http://127.0.0.1/industry/api
NJ607_INDUSTRY_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ607_INDUSTRY_MAX_SITES=10

# --- nj609_watchdog: Сторож контрагентов (воркер: сигналы риска) ---
NJ609_WATCHDOG_API_BASE=http://127.0.0.1/watchdog/api
NJ609_WATCHDOG_SITE_TOKEN=CHANGE_ME_token_iz_.env

# --- nj610_inbox: Входящие под контролем (воркер: IMAP -> черновики) ---
NJ610_INBOX_HOST=imap.yandex.ru:993
NJ610_INBOX_USER=
NJ610_INBOX_PASS=
NJ610_INBOX_FOLDER=INBOX
NJ610_INBOX_API_BASE=http://127.0.0.1/inbox/api
NJ610_INBOX_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ610_INBOX_LIMIT=20

# --- nj601_billing: выключатель монетизации (0 = весь сайт бесплатный) ---
# Пока посетителей нет — держите 0: списания не происходят, бесплатная
# норма не тратится, кнопки цен в UI скрыты. Чтобы включить — поставьте 1.
NJ601_BILLING_ENABLED=0

# --- nj602_content: воркер статей (search+LLM+публикация) ---
NJ602_CONTENT_API_BASE=http://127.0.0.1/content/api
NJ602_CONTENT_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ602_CONTENT_MODEL=
NJ602_CONTENT_MAX_SITES=6
NJ602_CONTENT_MD_CAP=2000

# --- nj612_touch: Серии касаний (воркер: черновики follow-up писем) ---
NJ612_TOUCH_API_BASE=http://127.0.0.1/touches/api
NJ612_TOUCH_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ612_TOUCH_MODEL=
# Автоотправка созревших шагов со стороны сайта (1 = вкл, по умолчанию 0 —
# только по кнопке владельца). Отправка — SMTP из секции email.
NJ612_TOUCH_AUTOSEND=0

# --- nj613_digest: Дайджест руководителю (воркер: недельное резюме) ---
NJ613_DIGEST_API_BASE=http://127.0.0.1/digest/api
NJ613_DIGEST_SITE_TOKEN=CHANGE_ME_token_iz_.env
NJ613_DIGEST_MODEL=

# Минимальный объём тела статьи (знаков), ниже которого nj602 дописывает
# продолжение отдельным LLM-вызовом (1400–58000, по умолчанию 1800).
NJ602_CONTENT_MIN_CHARS=1800

# --- nj594_orgregistry: Справочник организаций (ЕГРЮЛ/ЕГРИП) ---
# Запросы к ФНС (egrul.nalog.ru) идут через мягкий лимит: реестр не любит
# частых обращений и отвечает отказами. Лимит по адресу + общий кап платформы,
# плюс перерыв на повторный запрос, который только что дал «ничего не найдено».
NJ594_FNS_PER_MINUTE=5
NJ594_FNS_PER_HOUR=30
NJ594_FNS_TOTAL_PER_HOUR=120
NJ594_FNS_COOLDOWN=120
NJ594_FNS_TIMEOUT=12

# --- nj633_nettools: Сетевые инструменты (DNS/WHOIS/TCP) ---
# Безопасность: SSRF-щит закрывает приватные/внутренние адреса; проверки
# идут потоковыми сокетами, без shell. Лимиты в минуту/час с одного IP.
NJ633_RATE_PER_MINUTE=5
NJ633_RATE_PER_HOUR=60
NJ633_WHOIS_SERVER=whois.iana.org
NJ633_WHOIS_TIMEOUT=8
NJ633_TCP_TIMEOUT=6
# Модель для опции «Объяснить результат» (спека провайдер::модель или пусто)
NJ633_LLM_MODEL=

# --- nj634_pdf: PDF-инструменты (извлечение текста, текст->PDF, страницы) ---
# Всё на чистом PHP, без внешних бинарников. Лимит операций в минуту/час с IP.
NJ634_RATE_PER_MINUTE=5
NJ634_RATE_PER_HOUR=40
# Максимальный размер принимаемого PDF, мегабайт
NJ634_MAX_UPLOAD_MB=15
# Потолок сохраняемого в историю извлечённого текста, символов
NJ634_MAX_TEXT_CHARS=200000
# Свой TrueType-шрифт для «Текст -> PDF» (пусто = системный DejaVu Sans)
NJ634_FONT_TTF=

# --- nj636_pdfsign: Подписи и реквизиты PDF (stamp/count/strip) ---
# Всё на чистом PHP поверх движка nj634, без внешних бинарников.
NJ636_SCHEMA_AUTOCREATE=0
NJ636_RATE_PER_MINUTE=5
NJ636_RATE_PER_HOUR=40
NJ636_MAX_UPLOAD_MB=15
NJ636_MAX_SIGN_LINES=48

# --- nj637_watermark: Водяные знаки на PDF (диагональ / отпечаток) ---
# Всё на чистом PHP поверх движка nj634, без внешних бинарников.
NJ637_SCHEMA_AUTOCREATE=0
NJ637_RATE_PER_MINUTE=5
NJ637_RATE_PER_HOUR=40
NJ637_MAX_UPLOAD_MB=15
NJ637_MAX_TEXT_CHARS=400

# --- nj638_pdfplan: Конструктор А4 (шапка, 1-2 колонки, подвал, нумерация) ---
NJ638_SCHEMA_AUTOCREATE=0
NJ638_RATE_PER_MINUTE=5
NJ638_RATE_PER_HOUR=40
NJ638_MAX_TEXT_CHARS=120000

# --- nj639_qc: Контроль качества изделий (VLM + эталон + JSON-схема) ---
# Прогоны ставятся в очередь nj120 (канал nj639.analyze): воркер захватывает
# кадр из источника, шлёт его в vision-модель и валидирует ответ JSON-схемой.
# Таблицы создаются миграцией (NJ639_SCHEMA_AUTOCREATE — только для dev).
NJ639_SCHEMA_AUTOCREATE=0
NJ639_RATE_PER_MINUTE=5
NJ639_RATE_PER_HOUR=40
# Максимальный размер принимаемого изображения, мегабайт
NJ639_MAX_IMAGE_MB=15
# Лимит эталонных изображений на одно правило/прогон
NJ639_MAX_IMAGES=6

# --- nj640_cameras: Камеры цеха (видеонаблюдение, VLM) ---
# Прогоны ставятся в очередь nj120 (канал nj640.analyze): воркер снимает кадр
# с камеры, шлёт его в vision-модель и валидирует ответ JSON-схемой сценария.
# Нарушения → журнал событий (dedupe + cooldown) + уведомления nj597.
# Таблицы создаются миграцией (NJ640_SCHEMA_AUTOCREATE — только для dev).
NJ640_SCHEMA_AUTOCREATE=0
NJ640_RATE_PER_MINUTE=5
NJ640_RATE_PER_HOUR=40
# Максимальный размер принимаемого кадра, мегабайт
NJ640_MAX_IMAGE_MB=15
# Лимиты на аккаунт
NJ640_MAX_SCENES=20
NJ640_MAX_CAMERAS=12
# Дедупликация: окно одинакового события с одной камеры, сек
NJ640_DEDUPE_WINDOW_SEC=600
# Минимальный интервал между похожими тревогами (cooldown), сек
NJ640_COOLDOWN_MIN_SEC=300
# Таймаут захвата кадра на воркере, сек
NJ640_CAPTURE_TIMEOUT=15

# --- nj645_llmlab: Лаборатория LLM (демонстрации работы модели) ---
# Прогоны реальной модели идут через очередь nj120 (канал nj645.review),
# обработчик — workers/n2j_workers/handlers/nj645_review.py. Демонстрации
# «токены», «следующий токен», «эмбеддинги» и «разбор промпта» работают
# без ИИ и сети: им хватает своей базы.
NJ645_TEXT_MAX=12000
NJ645_CORPUS_MAX=6000
NJ645_VECTORS_KEEP=400
NJ645_QUIZ_LEN=5
# Лимиты на посетителя (демонстрации без ИИ не ограничиваются)
NJ645_RUNS_PER_HOUR=20
NJ645_CORPUS_PER_DAY=10

# --- nj646_label: Разбор состава по этикетке (еда и косметика) ---
# База веществ накапливается сама: фото этикетки распознаёт vision-модель
# (канал nj646.label), незнакомые вещества изучает LLM (канал nj646.study),
# обработчик — workers/n2j_workers/handlers/nj646_label.py.
# Без ИИ сервис работает: разбор текста идёт по накопленной базе.
NJ646_MAX_TEXT_CHARS=8000
NJ646_MAX_ITEMS=120
NJ646_MAX_PHOTO_MB=8
# Пределы ЗАПИСИ в базу (КБ): страховка колонок, помимо лимитов формы выше.
# Обрезка помечается в разборе («состав сохранён в сокращении»), а не молчит.
NJ646_MAX_RAW_TEXT_KB=64
NJ646_MAX_RESULT_KB=256
# Лимиты на посетителя/IP
NJ646_ANALYSES_PER_HOUR=30
NJ646_PHOTO_PER_HOUR=10
NJ646_STUDY_PER_DAY=10
# Сколько раз вещество должно встретиться до автоизучения и сколько изучаем за разбор
NJ646_UNKNOWN_MIN_SEEN=2
NJ646_UNKNOWN_PER_RUN=3
# Развёрнутый ответ (по умолчанию ВКЛЮЧЁН): разбор не заканчивается первой
# оценкой — незнакомые вещества уходят на изучение сразу, страница показывает
# ход изучения, а когда карточки готовы, ответ пересчитывается по пополненной
# базе. NJ646_DETAILED=0 возвращает прежнее поведение (изучение только со
# второго упоминания и без ожидания).
NJ646_DETAILED=1
# Сколько незнакомых веществ изучаем за один разбор в этом режиме
NJ646_DETAILED_STUDIES=3
# Сколько секунд страница ждёт изучение, прежде чем честно показать
# промежуточный ответ («эти N веществ ещё изучаются»)
NJ646_DETAILED_WAIT_SEC=45

# --- Полный ответ (NJ646_FULL_ANSWER) ------------------------------------------
# Режим, при котором пользователь получает ПОЛНЫЙ готовый ответ: к тому, что уже
# есть в базе, автоматически изучается ВСЁ неизученное из состава, страница
# ждёт карточки и сама обновляет разбор, пока в нём остаются неизвестные
# позиции. Отличие от развёрнутого: там изучается пачка (NJ646_DETAILED_STUDIES),
# здесь — весь состав, и у автоизучения свой, более высокий суточный лимит.
# По умолчанию ВЫКЛЮЧЕН: режим дорогой (один большой состав = десятки запросов
# к модели), включайте осознанно.
NJ646_FULL_ANSWER=0
# Сколько незнакомых веществ изучать за разбор. 0 — без предела (весь состав).
NJ646_FULL_STUDIES=0
# Сколько страница ждёт карточки, прежде чем показать промежуточный ответ
# (дальше ждёт в фоне и обновляет разбор сама).
NJ646_FULL_WAIT_SEC=300
# Суточный лимит автоизучений в этом режиме (на IP): отдельный и выше
# NJ646_STUDY_PER_DAY, иначе «изучить всё» встанет на третьем веществе.
NJ646_FULL_PER_DAY=60

# Сколько своих разборов видит посетитель во вкладке «Мои разборы» (5..50)
# и сколько записей на странице истории админа (10..200)
#NJ646_HISTORY_USER=20
#NJ646_HISTORY_ADMIN=30
# Сколько веществ показывать в листе дерева справочника админа за раз (10..200)
#NJ646_CATALOG_PAGE=60

# --- Логи сайта (плоский ротируемый файл) --------------------------------------
# Kohana пишет PHP-логи в application/logs/YYYY/MM/DD.php — их неудобно читать и
# невозможно приложить к разбору. Дополнительно сайт ведёт ОДИН плоский лог:
#   application/logs/n2j-site.log
# Туда попадают приёмка результатов воркеров (403 неверный токен, 404 прогон не
# найден, 500 приёмка упала — с классом и текстом исключения), постановка фото в
# очередь и предупреждения приложения. Именно этот файл нужен при разборе
# «фото уходит, а результата нет» (инцидент 03.10.2026).
# Путь к файлу (по умолчанию application/logs/n2j-site.log)
#N2J_LOG_FILE=
# Уровень: DEBUG | INFO | WARNING | ERROR (по умолчанию INFO)
#N2J_LOG_LEVEL=INFO
# Размер одного файла, МБ, и сколько архивов хранить (по умолчанию 5 и 5)
#N2J_LOG_MAX_MB=5
#N2J_LOG_BACKUPS=5
# 0 — файловый лог выключен (останется только php-лог ядра)
N2J_LOG_ENABLED=1

# --- Навыки Алисы (nj657) -------------------------------------------------------
# Вебхук Яндекс.Диалогов живёт на /alice/webhook. Адрес сайта для показа
# вебхука в панели управления (без слэша в конце; по умолчанию https://n2j.ru)
#NJ657_WEBHOOK_BASE=https://n2j.ru
# Публикация ответов навыка в MQTT (домашние дисплеи, ESP32): 1 = включить.
# Топик задаётся отдельно в настройках каждого навыка (/alice/admin).
NJ657_MQTT_ENABLED=0
# Брокер MQTT и авторизация (логин/пароль можно оставить пустыми)
#NJ657_MQTT_HOST=mqtt.example.ru
#NJ657_MQTT_PORT=1883
#NJ657_MQTT_USER=
#NJ657_MQTT_PASSWORD=
# Таймаут подключения/записи, секунды (вебхук не должен виснуть на брокере)
#NJ657_MQTT_TIMEOUT_SEC=2

# --- Озвучивание текста (nj665) ------------------------------------------------
# Сервис ходит в OmniVoice API v1: POST /api/v1/audio/speech (синтез),
# GET /api/v1/models?output_modalities=speech (каталог моделей, голосов и
# форматов; ключ не нужен) и GET /api/v1/key (состояние ключа).
# Без адреса и ключа страница /voice открывается, но синтез недоступен.
# Адрес внешнего API без слэша в конце
#NJ665_API_URL=https://voice.example.ru
# Ключ уходит заголовком Authorization: Bearer …
#NJ665_API_KEY=
# Модель и голос по умолчанию. Пусто — берётся первая речевая модель из
# /api/v1/models и первый её голос (по умолчанию k2-fsa/omnivoice).
#NJ665_MODEL=
#NJ665_VOICE=
# Формат файла: mp3 | wav | opus | flac | aac | pcm. В v1 по умолчанию pcm —
# сырой поток без контейнера, браузер его не играет, поэтому здесь mp3.
#NJ665_FORMAT=mp3
# Скорость речи по умолчанию и сколько символов уходит в одном запросе
#NJ665_SPEED=1.0
#NJ665_MAX_CHARS=4000
# Секунд на запрос синтеза (и на служебные запросы — моделей и ключа)
#NJ665_TIMEOUT=120
#NJ665_SHORT_TIMEOUT=15
# Распознавание речи для разговора на /talk: POST /api/v1/audio/transcriptions,
# тот же адрес и ключ. Модель и таймаут на одну реплику, секунды.
#NJ665_ASR_MODEL=whisper-1
#NJ665_ASR_TIMEOUT=60
# Путь распознавания. Если у вашего шлюза OmniVoice он другой (или ASR нет и
# нужен внешний OpenAI-совместимый сервис) — задайте свой адрес.
#NJ665_ASR_PATH=/api/v1/audio/transcriptions
# Лимитер: синтез занимает GPU, поэтому порог ниже, чем у «бумажных» сервисов
#NJ665_RATE_PER_MINUTE=5
#NJ665_RATE_PER_HOUR=30
# Срок хранения файлов и записей журнала, дней, и сколько чистить за раз
#NJ665_TTL_DAYS=30
#NJ665_SWEEP_LIMIT=20
# Минут, сколько держать в памяти каталог моделей и голосов
#NJ665_CATALOG_TTL=60

# --- Многоголосая озвучка книги (nj666, /multivoice) -----------------------------
# Книгу разбирает python-воркер (каналы nj666.plan и nj666.voice). Длинный синтез
# тоже делает воркер (тот же NJ665_API_URL/KEY, что у /voice): иначе nginx
# обрывает php-fpm, а TTS-сервер пишет звук в никуда. Превью голоса — сайт.
# Сколько знаков текста уходит модели за один заход: в запросе живут ещё
# правила, список персонажей и каталог голосов, поэтому окно узкое.
#NJ666_WINDOW_CHARS=6000
# Сколько персонажей показывать модели (самые упоминаемые) и сколько голосов
# предлагать ей для новых персонажей
#NJ666_LIST_CHARS=40
#NJ666_LIST_VOICES=24
# Примерный контекст модели в токенах: окно текста ужимается под него
#NJ666_CONTEXT=16000
# Модель разбора («провайдер::модель»). Пусто — модель воркера по умолчанию.
#NJ666_MODEL=
# «Утка го»: искать состав действующих лиц известной книги в интернете.
# 0 — запретить (персональный или закрытый текст).
#NJ666_SEARCH=1
#NJ666_SEARCH_TIMEOUT=45
# Адрес сайта и токен для воркера. Пусто — общий NJ120_API_BASE + /multivoice/w
# и WORKER_SITE_TOKEN
#NJ666_API_BASE=
#NJ666_SITE_TOKEN=
# Таймаут задачи разбора/озвучки, секунд (книга — это десятки вызовов модели)
#NJ666_PLAN_TIMEOUT=3600
#NJ666_VOICE_TIMEOUT=3600
# Сколько знаков в книге максимум и сколько знаков даёт минуту речи
#NJ666_MAX_CHARS=600000
#NJ666_CHARS_PER_MINUTE=950
# Длина блока по умолчанию, минут (блок заканчивается на логической паузе)
#NJ666_BLOCK_MIN=7
#NJ666_BLOCK_MAX=15
# Срок хранения книг, дней, и сколько чистить за раз
#NJ666_TTL_DAYS=30
#NJ666_SWEEP_LIMIT=10
# Лимитер: запуск разбора и озвучки — дорогие операции
#NJ666_RATE_PER_MINUTE=5
#NJ666_RATE_PER_HOUR=30

# --- Графовый 3D-конструктор (nj667, /graph3d) ------------------------------------
# Граф, саммари и вектор считает python-воркер (каналы nj667.generate /
# inpaint / summary / embed; moderate — только при пре-модерации). Сайт
# держит граф, права и приёмку. Эмбеддинги — общие EMBEDDING_* / EMBEDDING_MM_*.
# Модель для сборки и достройки графа («провайдер::модель»). Пусто — модель воркера.
#NJ667_MODEL=
# Дешёвая модель для названия, описания, тегов, идей и пре-модерации.
# Пусто — та же, что NJ667_MODEL. Сборка графа всегда NJ667_MODEL.
#NJ667_LIGHT_MODEL=
# Адрес сайта и токен для воркера. Пусто — общий NJ120_API_BASE + /graph3d/w
# и WORKER_SITE_TOKEN
#NJ667_API_BASE=
#NJ667_SITE_TOKEN=
# Бюджет символов на граф в подсказке саммари и лимит ответа модели
#NJ667_CONTEXT=8000
#NJ667_MAX_TOKENS=4000
#NJ667_LLM_TIMEOUT=300
# Сколько похожих графов из каталога показывать модели (few-shot RAG)
#NJ667_FEW_SHOT=2
# Лимиты графа: AI-Guard не даст построить и опубликовать больше
#NJ667_MAX_NODES=500
#NJ667_MAX_EDGES=1200
#NJ667_MAX_PROMPT=1000
#NJ667_MAX_SUMMARY=4000
# Сцена: радиус куба (в тех же единицах, что ждём от модели), шаг магнитной
# сетки и радиус прилипания к осям соседей в пикселях экрана
#NJ667_CANVAS_RADIUS=24
#NJ667_SNAP=0.5
#NJ667_SNAP_PX=8
# Таймауты задач воркера, секунд
#NJ667_GENERATE_TIMEOUT=600
#NJ667_INPAINT_TIMEOUT=600
#NJ667_SUMMARY_TIMEOUT=300
#NJ667_EMBED_TIMEOUT=300
#NJ667_MODERATE_TIMEOUT=300
# Сборка изделия (/graph3d/b/<code>): спецификацию считает сайт, STL — воркер
# в OpenSCAD. Пороги собираемости — те же числа, что в наработках scad: угол
# между лучами меньше min_angle означает, что пазы пересекутся в одну дыру.
#NJ667_BUILD_MIN_ANGLE=22
#NJ667_BUILD_MIN_SPAN=5
# Лимиты сборки — свои: рендер дороже правки графа. scad_max_kb обязан быть
# меньше 300 КБ (жестяной лимит воркера в scad.py), max_stl_mb — столько,
# сколько сайт готов принять из воркера.
#NJ667_BUILD_MAX_NODES=400
#NJ667_BUILD_MAX_EDGES=1200
#NJ667_SCAD_MAX_KB=280
#NJ667_MAX_STL_MB=24
# Сколько секунд разрешено считать CSG (минуты, не секунды).
# Сколько уникальных типов узла отдаём в пачку «к печати» за раз и сколько на
# неё секунд: 12 рендеров дешевле доделать остатком, чем держать человека час.
# NJ667_BUILD_PARTS_BUDGET держать в ладу с NJ667_BUILD_TIMEOUT на сайте.
#NJ667_BUILD_PARTS_MAX=12
#NJ667_BUILD_PARTS_BUDGET=3600
#NJ667_BUILD_TIMEOUT=900
# Путь к openscad на сервере воркера: сайт по нему судит, ждать ли STL вообще.
#NJ667_OPENSCAD_BIN=
# Флаги по умолчанию для новой сборки (галки на странице): 1 — включено.
#NJ667_BUILD_MERGE_NODES=1
#NJ667_BUILD_SHOW_STICKS=1
#NJ667_BUILD_PERFORATION=0
# Пре-модерация перед каталогом. По умолчанию выкл: «Опубликовать» сразу
# в каталог, без новой ревизии. 1 — заявка к человеку и канал nj667.moderate.
#NJ667_PREMODERATE=0
# Срок хранения гостевых черновиков, дней, и сколько чистить за раз
#NJ667_TTL_DAYS=180
#NJ667_SWEEP_LIMIT=20
# Файлы на диске (/graph3d/settings): устаревшие сборки старше N дней, порция
# очистки в файлах и порог возраста для сирот (секунды)
#NJ667_STORAGE_STALE_DAYS=30
#NJ667_STORAGE_BATCH=500
#NJ667_STORAGE_ORPHAN_MIN_AGE=3600
# Лимитер: каждая сборка — вызов модели
#NJ667_RATE_PER_MINUTE=6
#NJ667_RATE_PER_HOUR=60

# --- Плоские иллюстрации (nj668, /draw2d) --------------------------------------
# Сцену считает python-воркер (канал nj668.generate). Сайт держит JSON сцены,
# права и приёмку. Модель («провайдер::модель»). Пусто — модель воркера.
#NJ668_MODEL=
# Дешёвая модель для идей. Пусто — та же, что NJ668_MODEL.
#NJ668_LIGHT_MODEL=
# Адрес сайта и токен для воркера. Пусто — общий NJ120_API_BASE + /draw2d/w
# и WORKER_SITE_TOKEN
#NJ668_API_BASE=
#NJ668_SITE_TOKEN=
# Лимиты сцены
#NJ668_MAX_SHAPES=120
#NJ668_MAX_PROMPT=800
#NJ668_MAX_PROJECTS=200
#NJ668_MAX_REVISIONS=80
# Таймаут задачи воркера, секунд
#NJ668_GENERATE_TIMEOUT=600
#NJ668_IDEAS_TIMEOUT=180
# Длинная сторона кадра для vision, px
#NJ668_PHOTO_MAX_PX=512
# Срок хранения гостевых черновиков, дней, и сколько чистить за раз
#NJ668_TTL_DAYS=180
#NJ668_SWEEP_LIMIT=20
# Лимитер: каждая сборка — вызов модели
#NJ668_RATE_PER_MINUTE=6
#NJ668_RATE_PER_HOUR=40

# --- nj597_notifications: мессенджеры (только окружение PHP сайта) ---
# Без токена И имени бота канал скрыт в пользовательских настройках.
# После настройки выбрать webhook/poll в /nj597/admin?tab=channels.
#NJ597_NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
# Имя без @, например n2j_notify_bot (не URL).
#NJ597_NOTIFICATIONS_TELEGRAM_BOT_NICK=
#NJ597_NOTIFICATIONS_MAX_BOT_TOKEN=
# Имя/идентификатор из ссылки бота; шаблон ссылки — config/nj597_notifications.php, max.bot_link.
#NJ597_NOTIFICATIONS_MAX_BOT_NICK=
# Необязательный бизнес-транспорт MAX, не самостоятельная привязка пользователя.
#NJ597_NOTIFICATIONS_MAX_BUSINESS_KEY=
# HTTPS-адрес провайдера бизнес-API; секрет передаётся заголовком, не в URL.
#NJ597_NOTIFICATIONS_MAX_BUSINESS_ENDPOINT=
# Полные ключи выше приоритетнее прежних NJ597_TELEGRAM_*/NJ597_MAX_* и TELEGRAM_*/MAX_*.
# Почта: EMAIL_DSN + EMAIL_FROM + NJ597_EMAIL_ENABLED=1 (см. выше); null://null не доставляет.
# Общий WORKER_API_TOKEN уже описан выше: X-Worker-Token для POST /nj597/api/outbox.
# Секрет подписи ссылок «больше не присылать» в письмах (/nj597/unsub).
# Пусто = берём WORKER_API_TOKEN, затем APP_URL; отдельное значение полезно,
# чтобы отозвать все старые ссылки отписки, просто сменив строку ниже.
#NJ597_NOTIFICATIONS_UNSUB_SECRET=

# --- nj661_airadar: анализ материалов воркером (jq: канал воркера) ---
# Живой прогон 15.10.2026: рассуждающая модель Qwen3.5-9B израсходовала 2953
# токена из 3000 на reasoning_content, JSON анализа оборвался, прогон закрылся
# «LLM не проанализировала ни одного материала». Воркер теперь расширяет бюджет
# ответа, мельчит пачки и глушит размышления. Значения ниже не обязательны.
# Запас ответа для рассуждающей модели, токенов (по умолчанию 8000, потолок — половина NJ661_AIRADAR_CONTEXT).
#NJ661_AIRADAR_OUT_TOKENS=8000
# auto — решить по факту первого ответа, 0 — отвечать без размышлений сразу, 1 — не глушить их.
#NJ661_AIRADAR_THINK=auto

# --- 3D-детали (nj669, /solid3d, канал nj669.generate) ----------------------
# Своя база — полный API-путь, напр. https://n2j.ru/solid3d/w;
# пусто = NJ120_API_BASE (корень сайта) + /solid3d/w.
NJ669_API_BASE=
# Должен совпадать с WORKER_API_TOKEN сайта; пусто = общий WORKER_SITE_TOKEN.
NJ669_SITE_TOKEN=
# Провайдер::модель для кода; пусто = дефолт LLM воркера.
NJ669_MODEL=
# Модель с поддержкой изображений; пусто = общая VLM_MODEL.
NJ669_VISION_MODEL=
# Только воркер: путь к OpenSCAD; пусто = NJ570_OPENSCAD_BIN/автопоиск/PATH.
# Встроенные примитивы: BOSL2 не требуется. Нужны headless OpenGL/Xvfb и Pillow.
NJ669_OPENSCAD_BIN=
# Квоты/модели/0–2 починки — /solid3d/settings, отдельные квоты — /solid3d/limits.
# Приватные файлы: storage/nj669; включить в DEPLOY_MODULE_STORAGE, если задан свой список.
# Недорогая текстовая модель для идей и карточек (провайдер::модель).
NJ669_LIGHT_MODEL=

# --- ProcessHub (nj670, /process) ---------------------------------------------
# Схему «План» собирает python-воркер (канал nj670.synthesize): текст, PDF,
# скан/фото и аудио. Журнал событий разбирает nj670.mine, аудит «план ↔ факт» —
# nj670.diff, регламент DOCX/PDF — nj670.export. Сайт держит онтологию,
# версии, права и демо-сценарий; воркер в PostgreSQL не ходит.
# Модель для синтеза схемы и аудита («провайдер::модель»). Пусто — модель воркера.
#NJ670_MODEL=
# Дешёвая модель для AI-дополнения выбранного узла. Пусто — NJ670_MODEL.
#NJ670_LIGHT_MODEL=
# Для аудио (голосовое из мессенджера, диктофон): OpenAI-совместимый
# /audio/transcriptions. Без адреса аудио честно отклоняется с подсказкой.
#NJ670_ASR_URL=
#NJ670_ASR_KEY=
#NJ670_ASR_MODEL=whisper-1
# Присутствие воркера. Воркер раз в минуту шлёт POST /process/w/ping; сайт
# считает его живым, если пульс свежее окна. Раньше признаком была только
# взятая задача, поэтому простаивающий воркер выглядел выключенным.
# Окно пульса, минуты (по умолчанию 5). NJ670_WORKER_FORCE_ONLINE=1 —
# временно считать воркер живым (например, за NAT без обратной связи).
#NJ670_WORKER_PRESENCE_MINUTES=5
#NJ670_WORKER_FORCE_ONLINE=0
# Приватные файлы модуля: источники схем и готовые регламенты.
# При заданном DEPLOY_MODULE_STORAGE добавить storage/nj670 в список.

# --- Стенд эмбеддингов (nj671, /embedbench) -----------------------------------
# Сайт ничего не считает и своих адресов эмбеддингов не имеет: метрики мерит
# python-воркер, у него свои `workers/.env` (EMBEDDING_API_URL и
# EMBEDDING_MM_API_URL). Здесь живёт только то, что видно на странице.
# Сколько прогонов с одного адреса в час (стенд админский, но очередь общая).
#NJ671_RUNS_PER_HOUR=6
# Предел задачи в очереди, секунды: первый прогон грузит модель в память.
#NJ671_TIMEOUT_SEC=600
# Отчёты старше 180 дней чистит /nj100/cleanup (объявлено манифестом модуля).

# --- Сканер безопасности ИИ-моделей (nj672, /aiscan) ----------------------------
# Сайт не атакует сам: аудит (батарея атак OWASP LLM + стресс) считает
# python-воркер, канал nj672.scan. Пресеты цели и ключи — у воркера
# (NJ672_TARGET_* в workers/.env), здесь только пределы и цена оценки TCO.
# Сколько аудитов с одного адреса в час (аудит — это трафик по чужому эндпоинту).
#NJ672_RUNS_PER_HOUR=4
# Предел задачи в очереди, секунды: полная батарея + стресс до 100 потоков.
#NJ672_TIMEOUT_SEC=1800
# Сколько своих промптов аудитора принять из датасета формы.
#NJ672_CUSTOM_MAX=50
# Оценка стоимости аудита в отчёте: рублей за 1 млн токенов цели (0 — не показывать).
#NJ672_PRICE_PER_1M_RUB=0
# Отчёты старше 90 дней чистит /nj100/cleanup (объявлено манифестом модуля).

# --- MCP Hub (nj676, /mcphub): каталог MCP-серверов и шлюз для агентов --------
# Автосборку запускает кнопка «Найти и добавить» в /mcphub/admin. Добор по
# внешнему таймеру (POST /mcphub/api/tick с X-Worker-Token) выключен по
# умолчанию: пока флага нет, эндпоинт отвечает «автосборка выключена».
#NJ676_AUTO_DISCOVER=0
# Сколько карточек добирать по расписанию (по умолчанию 6, максимум 30).
#NJ676_AUTO_COUNT=6
# Тема ночной автосборки берётся из спроса агентов (/mcphub/admin → «Спрос
# агентов»): самый частый запрос, по которому в каталоге ничего не нашлось.
# 0 — собирать «самое заметное», как раньше, без оглядки на спрос.
#NJ676_AUTO_DEMAND=1
# Поиск агента без ответа сразу ставит автосборку по этой теме (0 — только
# накопление спроса, без мгновенных прогонов).
#NJ676_DEMAND_QUEUE=1
# Ограничители мгновенных прогонов: пауза между ними и потолок в сутки.
#NJ676_DEMAND_MIN_SEC=1800
#NJ676_DEMAND_MAX_DAY=6
# Сколько карточек брать в прогоне по спросу.
#NJ676_DEMAND_COUNT=6
# Сколько дней хранить журнал запросов агентов.
#NJ676_DEMAND_KEEP_DAYS=180
# 0 — автособранные карточки сохраняются черновиками (публикация вручную).
# По умолчанию карточки публикуются сразу: каталог должен жить сам.
#NJ676_AUTO_PUBLISH=1
# MCP-эндпоинт для агентов — POST /mcphub/mcp (старый /mcphub/api/rpc работает).
# Анонимно доступны каталог и вызовы серверов без ключей; инструменты N2J —
# только по ключу с /mcp. Бюджеты анонимного доступа раздельные: чтения
# (search/status/describe) дешевле, вызовы инструментов — дороже. У каждого
# есть часовой лимит и минутный burst-запас; при исчерпании шлюз отвечает
# 429 + Retry-After и кодом RATE_LIMITED. Ключ с /mcp лимитов не имеет.
#NJ676_ANON=1
#NJ676_ANON_READ_LIMIT=600
#NJ676_ANON_READ_BURST=60
#NJ676_ANON_CALL_LIMIT=60
#NJ676_ANON_CALL_BURST=12
# Старый общий лимит (в час на IP): работает как лимит чтения, если
# NJ676_ANON_READ_LIMIT не задан.
#NJ676_ANON_LIMIT=120
# Живая проверка удалённых серверов: внешний таймер (POST /mcphub/api/tick)
# ставит её сам не чаще, чем раз в NJ676_PROBE_EVERY_SEC секунд.
#NJ676_AUTO_PROBE=1
#NJ676_PROBE_EVERY_SEC=21600
#NJ676_SELFCHECK_LIMIT=12
# Готовность: сколько дней без живой проверки считать «давно не проверялся»
# (по умолчанию 7). Влияет на фильтр readiness=ready и отдачу в шлюз.
#NJ676_STALE_DAYS=7
# Авто-демот по отзывам: столько РАЗНЫХ агентов (уникальных ключей) должны
# прислать отрицательный отзыв, чтобы сервер ушёл в degraded и встал в начало
# очереди проверки. Один агент сервер не роняет.
#NJ676_DEMOTE_REPORTS=3
# Сколько дней хранить телеметрию вызовов и отзывы (call_id, латентность,
# коды ошибок). Чистится ночным тиком.
#NJ676_CALLS_KEEP_DAYS=180
# Разрешить http://127.0.0.1 в проксировании — ТОЛЬКО для стенда и только вне
# production (.tools/nj676_mcp_stub.py). На бою оставить выключенным.
#NJ676_ALLOW_LOCAL_PROBE=0
# Импорт официального реестра MCP идёт каналом nj676.registry (кнопка в админке).
# Шлюз проксирует вызовы в удалённые MCP-серверы каталога.
# Ключ такого сервера не хранится в БД: переменная собирается из slug
# (NJ676_REMOTE_TOKEN_<SLUG_В_ВЕРХНЕМ_РЕГИСТРЕ>), например:
#NJ676_REMOTE_TOKEN_EXA_MCP_SERVER=

# --- Разговор с ИИ голосом (nj677, /talk) ---------------------------------------
# Одно нажатие включает микрофон, дальше конец фразы определяет тишина: кнопок
# на каждую реплику нет. Речь распознаёт и ответ озвучивает nj665_voice — здесь
# только адрес и ключ NJ665_API_URL / NJ665_API_KEY, своих ключей модуль не имеет.
# Модель разговора («провайдер::модель»). Пусто — модель платформы из llm.php.
#NJ677_MODEL=
# Голос по умолчанию (из каталога OmniVoice). Пусто — голос nj665.
#NJ677_VOICE=
# Язык распознавания и синтеза и скорость речи (разговор чуть быстрее нормы).
#NJ677_LANGUAGE=ru
#NJ677_SPEED=1.05
# Системная подсказка: разговор должен быть коротким, иначе слушать устанешь.
#NJ677_SYSTEM_PROMPT=
# Ответ модели: символов реплики, знаков контекста и длина ответа в токенах.
#NJ677_TURN_CHARS=2000
#NJ677_HISTORY_TURNS=12
#NJ677_HISTORY_CHARS=6000
#NJ677_MAX_TOKENS=220
#NJ677_TEMPERATURE=0.6
# Озвучка по частям: символов в одной части, частей на ответ и сколько знаков
# ответа вообще читать вслух (длинный хвост остаётся текстом на экране).
#NJ677_TTS_CHARS=200
# Формат озвучки: mp3 (компактно) или wav (без потерь). Если голос ответа
# кажется приглушённым — поставьте wav: файлы больше, высокие частоты целы.
#NJ677_TTS_FORMAT=mp3
#NJ677_TTS_PARTS=10
#NJ677_SPEAK_CHARS=1600
# Запись с микрофона: предел размера в килобайтах и длина реплики, секунды.
#NJ677_AUDIO_MAX_KB=4096
#NJ677_AUDIO_MAX_SEC=60
# Лимитер ходов на аккаунт: распознавание и синтез тратят внешний API.
#NJ677_RATE_PER_MINUTE=20
#NJ677_RATE_PER_HOUR=240
# Сколько последних разговоров показывать на странице и сколько их хранить.
#NJ677_RECENT_LIMIT=5
#NJ677_TTL_DAYS=30
