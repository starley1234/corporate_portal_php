# ==============================================================================
# PRX — КОРПОРАТИВНЫЙ ПОРТАЛ
# Скопируйте файл в .env через `bash bin/setup.sh`
# ВНИМАНИЕ: Секреты не коммитить! Перед production задайте APP_URL и надёжные пароли.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОСНОВНОЕ ОКРУЖЕНИЕ И ПРИЛОЖЕНИЕ
# ------------------------------------------------------------------------------
KOHANA_ENV=development
STRICT_DEPRECATIONS=0
APP_URL=http://localhost:8080
APP_PORT=8080
APP_INTERNAL_HOSTS=

# Системные соли и ключи безопасности приложения
COOKIE_SALT=
AUTH_HASH_KEY=


# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ (PostgreSQL)
# ------------------------------------------------------------------------------
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=prx
DB_DEFAULT_USER=prx
DB_DEFAULT_PASS=prx
DB_DEFAULT_SCHEMA=public


# ------------------------------------------------------------------------------
# 3. АДМИНИСТРАТОРЫ И ПЕРВИЧНАЯ ИНИЦИАЛИЗАЦИЯ (SEED)
# ------------------------------------------------------------------------------
# Первичный администратор для чистой установки (миграция prx110_004).
# На production ОБЯЗАТЕЛЬНО: PRX_DEFAULT_ADMIN=0, создавайте админа через `make seed`.
PRX_DEFAULT_ADMIN=1
# Пусто = 'admin' (только для локальной разработки!)
PRX_DEFAULT_ADMIN_PASSWORD=
# PRX_DEFAULT_ADMIN_EMAIL=admin@example.test

# Параметры для команды `make seed` (создание дополнительного администратора):
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
# Пароль для `make seed`. Первичный admin/admin создаёт миграция prx110_004 только на пустой базе.
ADMIN_PASSWORD=


# ------------------------------------------------------------------------------
# 4. СЛУЖЕБНЫЕ ТОКЕНЫ И БЕЗОПАСНОСТЬ СИСТЕМЫ
# ------------------------------------------------------------------------------
MIGRATIONS_TOKEN=
SITE_UPDATE_TOKEN=
# Основной токен взаимодействия воркеров с бэкендом
WORKER_API_TOKEN=
WORKER_SITE_TOKEN=


# ------------------------------------------------------------------------------
# 5. ИНТЕГРАЦИИ ИИ / LLM (ПРОВАЙДЕРЫ МОДЕЛЕЙ)
# Вызов моделей в коде: <провайдер>::<название_модели>
# Доступные провайдеры: local, openrouter, toolforge
# ------------------------------------------------------------------------------
# Дефолтная модель (если поддерживается кодовой базой)
DEFAULT_LLM_MODEL=local::unsloth/qwen3.5-9b
#DEFAULT_VLM_MODEL=openrouter::deepseek/deepseek-v4.1-flash-1017

# --- Провайдер 1: Local (Ollama / vLLM / LM Studio / LocalAI) ---
LOCAL_API_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=not-needed

# --- Провайдер 2: OpenRouter (Облачный AI-шлюз) ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Провайдер 3: Toolforge (Корпоративный AI-шлюз) ---
TOOLFORGE_API_URL=
TOOLFORGE_API_KEY=


# ------------------------------------------------------------------------------
# 6. ЭМБЕДДИНГИ И СЕМАНТИЧЕСКИЙ ПОИСК
# ------------------------------------------------------------------------------
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32


# ------------------------------------------------------------------------------
# 7. СИСТЕМА OCR (Распознавание сканов и PDF)
# ------------------------------------------------------------------------------
# Провайдер: tesseract (локально) | remote (внешний HTTP-сервис)
OCR_PROVIDER=tesseract
OCR_TIMEOUT=120

# Настройки для OCR_PROVIDER=remote:
OCR_SERVICE_URL=
OCR_API_KEY=
# Заголовок по умолчанию: 'Authorization: Bearer <key>'. Если нужен сырой ключ: X-API-Key
OCR_AUTH_HEADER_NAME=
# JSON multipart data (output_format, lang...)
OCR_EXTRA_PARAMS={}
# JSON дополнительных HTTP-заголовков
OCR_EXTRA_HEADERS={}


# ------------------------------------------------------------------------------
# 8. ФОНОВЫЕ ВОРКЕРЫ (Background Queue & Workers)
# ------------------------------------------------------------------------------
WORKER_NAME=worker-1
WORKER_PG_DSN=postgres://prx:prx@127.0.0.1:5432/prx
WORKER_CHANNELS=echo,embeddings.index,llm.summarize,semantic.index,doc.normalize,doc.analyze,doc.draft


# ------------------------------------------------------------------------------
# 9. БИЗНЕС-МОДУЛИ СИСТЕМЫ (PRX-МОДУЛИ)
# ------------------------------------------------------------------------------

# --- Базовые API модулей ---
PRX120_API_URL=http://localhost:8080/prx120/api
PRX120_API_BASE=http://localhost:8080
PRX115_API_BASE=http://localhost:8080/prx115/api
PRX115_SITE_TOKEN=

# Полные адреса модулей (раскомментировать, если воркеры вынесены на отдельный хост):
# PRX390_API_BASE=http://localhost:8080/prx390/api
# PRX392_API_BASE=http://localhost:8080/prx392/api
# PRX394_API_BASE=http://localhost:8080/prx394/api

# Токены доступа воркеров к модулям (если пусто — наследуют WORKER_SITE_TOKEN / WORKER_API_TOKEN):
PRX390_SITE_TOKEN=
PRX392_SITE_TOKEN=
PRX393_SITE_TOKEN=
PRX394_SITE_TOKEN=

# --- prx300: Кадровый импорт (CSV) ---
PRX300_IMPORT_MAX_BYTES=5242880
PRX300_IMPORT_MAX_ROWS=5000
PRX300_IMPORT_RETENTION_DAYS=180

# --- prx390-prx394: Документооборот и обработка документов ---
PRX390_INBOX_DIR=public_html/storage/docflow/inbox
PRX390_PROCESSED_DIR=public_html/storage/docflow/processed
PRX390_DUPLICATES_DIR=public_html/storage/docflow/duplicates
PRX390_ERROR_DIR=public_html/storage/docflow/error

# Модели для анализа и генерации проектов документов:
PRX392_MODEL=local::openai/gpt-oss-20b
PRX394_MODEL=

# --- prx398: VLM (Vision-Language Models для PDF и сканов) ---
# Модель должна поддерживать изображения. По умолчанию разрешён только local.
# PRX398_VLM_MODEL=local::qwen_qwen3-vl-4b-instruct
# PRX398_ALLOWED_PROVIDERS=local

# --- prx597: Почтовые уведомления ---
PRX597_EMAIL_ENABLED=0
EMAIL_DSN=
EMAIL_FROM=no-reply@example.test
EMAIL_FROM_NAME=PRX


# ------------------------------------------------------------------------------
# 10. ДЕПЛОЙ И CI/CD
# ------------------------------------------------------------------------------
DEPLOY_BRANCH=