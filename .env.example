# PRL — корпоративный портал. Скопируйте через bash bin/setup.sh.
# Секреты не коммитить. Перед production задайте свой APP_URL и пароли.
KOHANA_ENV=development
STRICT_DEPRECATIONS=0
APP_URL=http://localhost:8080
APP_INTERNAL_HOSTS=
APP_PORT=8080
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=prl
DB_DEFAULT_USER=prl
DB_DEFAULT_PASS=prl
DB_DEFAULT_SCHEMA=public
COOKIE_SALT=
AUTH_HASH_KEY=
MIGRATIONS_TOKEN=
WORKER_API_TOKEN=
SITE_UPDATE_TOKEN=
ADMIN_EMAIL=admin@example.test
ADMIN_USERNAME=admin
# Пароль для `make seed` (создание дополнительного администратора).
# Первичный admin/admin создаёт миграция prl110_004, только на пустой базе.
ADMIN_PASSWORD=
# Первичный администратор для чистой установки. После первого входа смените
# пароль. На production поставьте PRL_DEFAULT_ADMIN=0 и используйте make seed.
PRL_DEFAULT_ADMIN=1
# Пусто = admin (только для локальной установки).
PRL_DEFAULT_ADMIN_PASSWORD=
# PRL_DEFAULT_ADMIN_EMAIL=admin@example.test
TOOLFORGE_API_URL=
TOOLFORGE_API_KEY=
LM_API_TOKEN=
OPENROUTER_API_URL=
OPENROUTER_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
PRL120_API_URL=http://localhost:8080/prl120/api
WORKER_PG_DSN=postgres://prl:prl@127.0.0.1:5432/prl
WORKER_NAME=worker-1
WORKER_CHANNELS=echo,embeddings.index,llm.summarize,semantic.index,doc.normalize,doc.analyze,doc.draft
WORKER_SITE_TOKEN=
PRL120_API_BASE=http://localhost:8080
PRL115_API_BASE=http://localhost:8080/prl115/api
PRL115_SITE_TOKEN=
EMAIL_DSN=
EMAIL_FROM=no-reply@example.test
EMAIL_FROM_NAME=PRL
PRL597_EMAIL_ENABLED=0
# Документооборот prl390–prl394: папка входящих и локальная модель.
# Пути можно не задавать — по умолчанию public_html/storage/docflow/{inbox,...}.
# Каталог закрыт от прямой отдачи правилом в public_html/.htaccess.
PRL390_INBOX_DIR=public_html/storage/docflow/inbox
PRL390_PROCESSED_DIR=public_html/storage/docflow/processed
PRL390_DUPLICATES_DIR=public_html/storage/docflow/duplicates
PRL390_ERROR_DIR=public_html/storage/docflow/error
PRL392_MODEL=local::openai/gpt-oss-20b
PRL394_MODEL=
# Токены API воркеров (если пусто — берётся WORKER_SITE_TOKEN / WORKER_API_TOKEN).
PRL390_SITE_TOKEN=
PRL392_SITE_TOKEN=
PRL393_SITE_TOKEN=
PRL394_SITE_TOKEN=
# Полные адреса модульных API нужны, только если воркер ходит не на PRL120_API_BASE.
# PRL390_API_BASE=http://localhost:8080/prl390/api
# PRL392_API_BASE=http://localhost:8080/prl392/api
# PRL394_API_BASE=http://localhost:8080/prl394/api
# prl300: guardrails кадрового CSV-импорта и срок хранения staging-пакетов.
PRL300_IMPORT_MAX_BYTES=5242880
PRL300_IMPORT_MAX_ROWS=5000
PRL300_IMPORT_RETENTION_DAYS=180
# Deployment: opt-in, no hard-coded upstream or production branch.
DEPLOY_BRANCH=
