# =============================================================================
#  PRX — переменные окружения (.env)
#
#  Как завести:   bash bin/setup.sh — создаст .env из этого файла и впишет
#                 сгенерированные секреты (существующий .env не трогает).
#  Один файл:     его читают и PHP, и воркер; workers/.env — только если
#                 воркеру нужно переопределить что-то своё.
#
#  Пометка [ОБЯЗАТЕЛЬНО]: без переменной сайт не поднимется или будет
#  небезопасен. Всё остальное — опционально, включайте по необходимости;
#  полный справочник — docs/ENVIRONMENT.md.
# =============================================================================


# =============================================================================
# 1. ОБЯЗАТЕЛЬНОЕ — проверьте перед запуском
# =============================================================================

# Среда. На production: KOHANA_ENV=production (строже trusted_hosts, ошибки
# не печатаются в ответ).
# [ОБЯЗАТЕЛЬНО на production]
KOHANA_ENV=development

# Канонический адрес сайта: canonical, og:url, ссылки в письмах и доверенный
# хост строются от него. На production — публичный https-адрес.
# [ОБЯЗАТЕЛЬНО на production]
APP_URL=http://localhost:8080

# --- Публичные домены (можно несколько) ---------------------------------------
# Сайт отвечает на все перечисленные домены; канонические ссылки — всегда от
# APP_URL. Канонический хост входит автоматически, дополнительные перечислите
# в APP_PUBLIC_HOSTS через запятую (строгий шаблон имени хоста, не regex).
# Пример production с двумя доменами:
#   APP_URL=https://work-ai.servers.local
#   APP_PUBLIC_HOSTS=dev.work-ai.servers.local
# APP_PUBLIC_HOSTS=
# APP_INTERNAL_HOSTS=nginx                # служебные DNS-имена сети (Docker)
# APP_PORT=8080
# STRICT_DEPRECATIONS=0

# --- PostgreSQL ---------------------------------------------------------------
# Одна база для сайта и PG-воркера. На production замените пароль.
# [ОБЯЗАТЕЛЬНО: свой пароль вместо prx/prx]
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=prx
DB_DEFAULT_USER=prx
DB_DEFAULT_PASS=prx
DB_DEFAULT_SCHEMA=public

# --- Секреты подписи ----------------------------------------------------------
# Соль cookie-подписей и ключ хеширования паролей. Генерируются bin/setup.sh
# (вручную: openssl rand -hex 32). На production пустыми оставлять НЕЛЬЗЯ.
# [ОБЯЗАТЕЛЬНО на production]
COOKIE_SALT=
AUTH_HASH_KEY=

# --- Токен сайта ↔ воркер -----------------------------------------------------
# Воркер авторизуется этим токеном на /prx120/api, /prx597/api и т.д.
# (Prx_Gate). Генерируется bin/setup.sh.
# [ОБЯЗАТЕЛЬНО при запуске воркера]
WORKER_API_TOKEN=


# =============================================================================
# 2. Служебные токены и входы
# =============================================================================

# GET-ссылка /update/kick/<SITE_UPDATE_TOKEN> для агента и скриптов; пусто —
# функция выключена.
SITE_UPDATE_TOKEN=
# Токен HTTP-механизма миграций; админ-сессия в UI проверяется отдельно.
# MIGRATIONS_TOKEN=
# WORKER_SITE_TOKEN=                      # только если старому API нужен отдельный общий токен
# LDAP выключен по умолчанию. Инструкция: application/modules/ldap_auth/README.md
# PRX_LDAP_ENABLED=0


# =============================================================================
# 3. Бренд и цветовая схема (site_config.php)
# =============================================================================
# Имя и заголовок — текст; логотип — HTML/иконка FontAwesome (файл редактирует
# администратор); палитра — orange, blue или yellow; свой акцент (hex)
# перекрывает палитру, DARK — вариант для тёмной темы (без него — светлый).
# PRX_SITE_NAME=PRX
# PRX_SITE_TITLE=PRX — платформа ИИ-сервисов
# PRX_SITE_LOGO=<i class="fas fa-layer-group mr-2"></i>
# PRX_COMPANY_ACCENT=orange
# PRX_ACCENT_COLOR=#ea580c
# PRX_ACCENT_COLOR_DARK=#fb923c


# =============================================================================
# 4. Воркер очереди (workers/prx_workers)
# =============================================================================
# Режим очереди: pg (напрямую из БД) или http (через API сайта). DSN по
# умолчанию собирается из DB_DEFAULT_*; пустой список каналов = все включённые.
# WORKER_QUEUE_MODE=pg
# WORKER_PG_DSN=postgresql://prx:ПАРОЛЬ@127.0.0.1:5432/prx
# WORKER_CHANNELS=
# WORKER_NAME=worker-1
# PRX120_API_BASE=https://platform.toolforge.ru     # только если воркеру нужен другой адрес, чем APP_URL
# PRX120_API_URL=https://platform.toolforge.ru/prx120/api  # только отдельный URL очереди HTTP
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL=5
# WORKER_IDLE_MAX_SEC=10
# WORKER_HEARTBEAT_INTERVAL=30


# =============================================================================
# 5. LLM и эмбеддинги (prx115, prx392, prx397, prx399…)
# =============================================================================
# Включайте только при наличии сервера модели; без переменных LLM-задачи
# честно сообщат о недоступности провайдера.
# LLM_DEFAULT_PROVIDER=local
# DEFAULT_LLM_MODEL=local::unsloth/qwen3.8-27b
# LOCAL_API_URL=http://127.0.0.1:11434/v1
# LOCAL_API_KEY=not-needed
# LOCAL_DEFAULT_MODEL=unsloth/qwen3.8-27b
# PRX392_MODEL=
# TOOLFORGE_API_URL=
# TOOLFORGE_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=32
# PRX115_API_BASE=
# PRX115_SITE_TOKEN=


# =============================================================================
# 6. Лимиты модулей-конвейеров (PHP и воркер читают корневой .env;
#    workers/.env переопределяет только для Python)
# =============================================================================

# --- prx395: PDF → текст ------------------------------------------------------
# Максимальный размер одного PDF, байты (1–100 МиБ).
# PRX395_MAX_PDF_BYTES=10485760
# Максимальное количество страниц в PDF (1–200).
# PRX395_MAX_PAGES=20
# Максимальная длина результата UTF-8, байты (1 КиБ–8 МиБ).
# PRX395_MAX_TEXT_BYTES=1048576
# Срок доступности исходника и результата с постановки, часы (1–168).
# PRX395_RESULT_TTL_HOURS=24
# Таймаут попытки в очереди, секунды (1–3600).
# PRX395_TASK_TIMEOUT_SEC=300
# Максимальное число попыток фоновой задачи (1–10).
# PRX395_MAX_ATTEMPTS=3
# Предел адресного пространства процесса чтения PDF на Linux, МиБ (64–4096).
# PRX395_PDF_MEMORY_MB=384

# --- prx396: большой PDF по частям --------------------------------------------
# Максимальный размер одного PDF, байты (1–500 МиБ).
# PRX396_MAX_PDF_BYTES=104857600
# Максимальное количество страниц в PDF (1–2000).
# PRX396_MAX_PAGES=500
# Страниц в одной части (1–100).
# PRX396_CHUNK_PAGES=10
# Максимальная длина итогового текста UTF-8, байты (1 КиБ–200 МиБ).
# PRX396_MAX_TEXT_BYTES=52428800
# Срок доступности исходника и результата с постановки, часы (1–720).
# PRX396_TTL_HOURS=72
# Алиас срока: читается, если PRX396_TTL_HOURS не задан.
# PRX396_RESULT_TTL_HOURS=72
# Таймаут попытки в очереди, секунды (1–7200).
# PRX396_TASK_TIMEOUT_SEC=1800
# Максимальное число попыток фоновой задачи (1–10).
# PRX396_MAX_ATTEMPTS=3
# Предел адресного пространства pypdf-подпроцесса (проба, нарезка части) на Linux, МиБ (64–4096).
# PRX396_PDF_MEMORY_MB=512
# Таймаут изолированного pypdf-подпроцесса: проба страниц и нарезка части, секунды (5–600).
# PRX396_PROBE_TIMEOUT_SEC=60

# --- prx397: поля из счёта/УПД ------------------------------------------------
# Максимальный размер PDF, байты (1–100 МиБ).
# PRX397_MAX_PDF_BYTES=10485760
# Максимальное количество страниц (1–200).
# PRX397_MAX_PAGES=20
# Максимум символов текста, отправляемых в LLM (1000–500000).
# PRX397_MAX_LLM_CHARS=60000
# Срок хранения результата, часы (1–168).
# PRX397_TTL_HOURS=24
# Таймаут попытки очереди, секунды (1–3600).
# PRX397_TASK_TIMEOUT_SEC=600
# Максимум попыток задачи (1–10).
# PRX397_MAX_ATTEMPTS=3
# Память подпроцесса разбора PDF, МиБ (64–4096).
# PRX397_PDF_MEMORY_MB=512

# prx400_specflow: лимиты разбора спецификаций (см. workers/.../prx400_specflow/limits.py)
# Хранение — фасад Storage (prx212). PRX400_STORAGE_DIR больше не нужен новым
# загрузкам и влияет только на самолечение легаси-записей (локальный каталог).
# PRX400_STORAGE_DIR=/var/lib/prx_storage/specflow
# Vision-разбор: максимум страниц на одну задачу (остальные обрезаются)
# PRX400_MAX_VISION_PAGES=8
# PRX400_MAX_PDF_BYTES=20971520
# PRX400_MAX_PAGES=40
# PRX400_MAX_TEXT_BYTES=4194304
# PRX400_MAX_ROWS=2000
# PRX400_PDF_MEMORY_MB=512

# --- prx398: маршрутизация документов -----------------------------------------
# Максимальный размер PDF, байты (1–100 МиБ).
# PRX398_MAX_PDF_BYTES=10485760
# Максимальное количество страниц (1–200).
# PRX398_MAX_PAGES=20
# Потолок извлечённого OCR-текста, байты (1–64 МиБ).
# PRX398_MAX_TEXT_BYTES=5242880
# Срок хранения результата, часы (1–168).
# PRX398_TTL_HOURS=24
# Таймаут попытки очереди, секунды (1–3600).
# PRX398_TASK_TIMEOUT_SEC=900
# Максимум попыток задачи (1–10).
# PRX398_MAX_ATTEMPTS=3
# Минимальная уверенность для автоматического маршрута (0.0–1.0).
# PRX398_CONFIDENCE_MIN=0.8
# Максимум повторов извлечения внутри графа (0–10).
# PRX398_MAX_RETRIES=2
# Чекпойнт графа: postgres|memory (memory только для тестов).
# PRX398_CHECKPOINT=postgres
# Свой DSN чекпойнта для режима WORKER_QUEUE_MODE=http (воркер без прямого
# доступа к очереди); пусто — берётся DSN очереди в режиме pg.
# PRX398_CHECKPOINT_DSN=
# Память подпроцесса разбора PDF, МиБ (64–4096).
# PRX398_PDF_MEMORY_MB=512

# --- prx399: слияние договоров и допсоглашений ---------------------------------
# Спека модели для дельт и аудита: 'провайдер::модель' (см. prx_workers/llm.py);
# пусто = модель провайдера по умолчанию.
# PRX399_MODEL=
# PRX399_MAX_PDF_BYTES=26214400
# PRX399_MAX_PAGES=300
# PRX399_MAX_TEXT_BYTES=524288
# PRX399_MAX_CHUNK_CHARS=12000
# PRX399_TASK_TIMEOUT_SEC=3600
# PRX399_PDF_MEMORY_MB=512

# --- prx450: внешний OCR-шлюз -------------------------------------------------
# Боевой Docling/MinerU/PaddleOCR или локальная обёртка Tesseract
# (services/tesseract-ocr, 127.0.0.1:8090/parse).
# PRX450_OCR_BASE_URL=http://127.0.0.1:8090/parse
# PRX450_OCR_API_KEY=
# PRX450_OCR_TIMEOUT=120
# PRX450_MAX_FILE_BYTES=26214400

# --- prx395 через UI (без API-ключа клиента и LLM) -----------------------------
# PDF через UI: Tesseract + Poppler — для сканов.
# OCR_PROVIDER=tesseract
# OCR_TIMEOUT=120
# Для внешнего OCR нового PDF-сервиса: OCR_PROVIDER=remote и полный URL /parse.
# OCR_SERVICE_URL=
# OCR_API_KEY=
# OCR_AUTH_HEADER_NAME=
# OCR_EXTRA_PARAMS={}
# OCR_EXTRA_HEADERS={}


# =============================================================================
# 7. API-доступ (prx150) и идемпотентность
# =============================================================================
# Ключи и лимиты внешнего API. Машинный доступ к prx395/prx450 — только через
# ключ prx150 со scope модуля; отдельных карт токенов больше нет.
# PRX150_DEFAULT_RATE_LIMIT=60
# PRX150_KEY_TTL_DAYS=0
# PRX150_IP_HASH_KEY=
# Идемпотентные ключи внешних операций (Prx_Idempotency), часов.
# PRX_IDEMPOTENCY_TTL_HOURS=24


# =============================================================================
# 8. Старый документооборот (prx390–393) и хранилища
# =============================================================================
# Переключается только в application/bootstrap.php.
# PRX390_INBOX_DIR=storage/docflow/inbox
# PRX390_PROCESSED_DIR=storage/docflow/processed
# PRX390_DUPLICATES_DIR=storage/docflow/duplicates
# PRX390_ERROR_DIR=storage/docflow/error
# PRX390_TEXT_RETENTION_DAYS=365
# PRX391_FIELD_EVENT_RETENTION_DAYS=1095
# PRX392_RUN_RETENTION_DAYS=365
# PRX390_SITE_TOKEN=
# PRX392_SITE_TOKEN=
# PRX393_SITE_TOKEN=
# PRX300_IMPORT_MAX_BYTES=5242880
# PRX300_IMPORT_MAX_ROWS=5000
# PRX300_IMPORT_RETENTION_DAYS=180


# =============================================================================
# 9. Уведомления и почта (prx597)
# =============================================================================
# PRX597_EMAIL_ENABLED=0
# EMAIL_DSN=
# EMAIL_FROM=no-reply@example.test
# EMAIL_FROM_NAME=PRX
# PRX208_DB_SUBSCRIBERS_ENABLED=0


# =============================================================================
# 10. Первый администратор и деплой
# =============================================================================
# Сид admin/admin только для чистой локальной БД. На production: 0 и `make seed`.
PRX_DEFAULT_ADMIN=1
# PRX_DEFAULT_ADMIN_PASSWORD=
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.test
# DEPLOY_BRANCH=
