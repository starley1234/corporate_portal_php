# Скопируйте через `bash bin/setup.sh`: он генерирует секреты, существующий .env не трогает.
# Один хост: PHP и воркер читают этот файл; workers/.env нужен только для переопределений.

# Сайт. Для systemd на portal.toolforge.ru замените две строки на:
# KOHANA_ENV=production
# APP_URL=https://portal.toolforge.ru
KOHANA_ENV=development
APP_URL=http://localhost:8080
# APP_PORT=8080
# APP_INTERNAL_HOSTS=nginx
# STRICT_DEPRECATIONS=0

# Та же PostgreSQL для сайта и PG-воркера. Замените пароль на пароль своей БД.
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=prx
DB_DEFAULT_USER=prx
DB_DEFAULT_PASS=prx
DB_DEFAULT_SCHEMA=public

COOKIE_SALT=
AUTH_HASH_KEY=
WORKER_API_TOKEN=
MIGRATIONS_TOKEN=
SITE_UPDATE_TOKEN=
# WORKER_SITE_TOKEN=             # только если старому API нужен отдельный общий токен

# По умолчанию: pg, DSN собирается из DB_DEFAULT_*, пустой список каналов = все включённые.
# WORKER_QUEUE_MODE=pg
# WORKER_PG_DSN=postgresql://prx:ПАРОЛЬ@127.0.0.1:5432/prx
# WORKER_CHANNELS=
# WORKER_NAME=worker-1
# PRX120_API_BASE=https://portal.toolforge.ru     # только если воркеру нужен другой адрес, чем APP_URL
# PRX120_API_URL=https://portal.toolforge.ru/prx120/api  # только отдельный URL очереди HTTP
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL=5
# WORKER_IDLE_MAX_SEC=10
# WORKER_HEARTBEAT_INTERVAL=30

# PDF через UI: API-ключ клиента и LLM не нужны. Tesseract + Poppler — для сканов.
# OCR_PROVIDER=tesseract
# OCR_TIMEOUT=120
# Для внешнего OCR нового PDF-сервиса: OCR_PROVIDER=remote и полный URL /parse.
# OCR_SERVICE_URL=
# OCR_API_KEY=
# OCR_AUTH_HEADER_NAME=
# OCR_EXTRA_PARAMS={}
# OCR_EXTRA_HEADERS={}
# PRX395_DOCUMENT_EXTRACT_CLIENTS='{}'   # задайте только для машинного API

# prx450: внешний OCR-шлюз — боевой Docling/MinerU/PaddleOCR или локальная
# обёртка Tesseract (services/tesseract-ocr, 127.0.0.1:8090).
# PRX450_OCR_BASE_URL=http://127.0.0.1:8090
# PRX450_OCR_API_KEY=
# PRX450_OCR_TIMEOUT=120
# PRX450_MAX_FILE_BYTES=26214400

# prx150: ключи и лимиты внешнего API.
# PRX150_DEFAULT_RATE_LIMIT=60
# PRX150_KEY_TTL_DAYS=0
# PRX150_IP_HASH_KEY=

# Старый документооборот переключается только в application/bootstrap.php.
# PRX390_INBOX_DIR=storage/docflow/inbox
# PRX390_PROCESSED_DIR=storage/docflow/processed
# PRX390_DUPLICATES_DIR=storage/docflow/duplicates
# PRX390_ERROR_DIR=storage/docflow/error
# PRX390_TEXT_RETENTION_DAYS=365
# PRX391_FIELD_EVENT_RETENTION_DAYS=1095
# PRX392_RUN_RETENTION_DAYS=365
# PRX390_SITE_TOKEN=
# PRX392_SITE_TOKEN=
# PRX393_SITE_TOKEN=

# ИИ-анализ и другие LLM-задачи: включайте только при наличии сервера модели.
# LLM_DEFAULT_PROVIDER=local
# DEFAULT_LLM_MODEL=local::unsloth/qwen3.8-27b
# LOCAL_API_URL=http://127.0.0.1:11434/v1
# LOCAL_API_KEY=not-needed
# LOCAL_DEFAULT_MODEL=unsloth/qwen3.8-27b
# PRX392_MODEL=
# TOOLFORGE_API_URL=
# TOOLFORGE_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=32
# PRX115_API_BASE=
# PRX115_SITE_TOKEN=

# Сид admin/admin только для чистой локальной БД. На production: 0 и `make seed`.
PRX_DEFAULT_ADMIN=1
# PRX_DEFAULT_ADMIN_PASSWORD=
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.test

# Остальные опции включайте по необходимости (docs/ENVIRONMENT.md).
# PRX208_DB_SUBSCRIBERS_ENABLED=0
# PRX300_IMPORT_MAX_BYTES=5242880
# PRX300_IMPORT_MAX_ROWS=5000
# PRX300_IMPORT_RETENTION_DAYS=180
# PRX597_EMAIL_ENABLED=0
# EMAIL_DSN=
# EMAIL_FROM=no-reply@example.test
# EMAIL_FROM_NAME=PRX
# DEPLOY_BRANCH=
