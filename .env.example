# ==============================================================================
# PRX — КОРПОРАТИВНЫЙ ПОРТАЛ
# ==============================================================================
# Это человекочитаемый контракт окружения. Скопируйте файл в `.env`
# (`bash bin/setup.sh`) и меняйте только то, что нужно вашему стенду.
#
# Порядок разделов: сначала общие настройки платформы (1–8), затем настройки
# модулей (9) — блоками от старых модулей к новым, затем деплой (10).
#
# В каждом разделе указаны:
#   Владелец      — код, который читает переменные;
#   Обязательность — что нельзя оставить пустым (в development есть умолчания).
#
# Значения по умолчанию живут в коде (`application/config/*.php`,
# `workers/prx_workers/config.py`), а не в этом файле: здесь — только то,
# что действительно меняется между стендами. Секреты в git не коммитим.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ПРИЛОЖЕНИЕ
# Владелец: application/bootstrap.php, application/config/*.php
# Обязательность: APP_URL, COOKIE_SALT, AUTH_HASH_KEY — на production.
# ------------------------------------------------------------------------------
KOHANA_ENV=development
STRICT_DEPRECATIONS=0
APP_URL=http://localhost:8080
APP_PORT=8080
# Дополнительные хосты, которым разрешено обращаться к приложению (через запятую).
APP_INTERNAL_HOSTS=

# Соли и ключи подписи. Сгенерируйте заново для каждого стенда.
COOKIE_SALT=
AUTH_HASH_KEY=


# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ (PostgreSQL)
# Владелец: application/config/database.php, миграции prx111_migrations
# Обязательность: DB_DEFAULT_NAME, DB_DEFAULT_USER — да.
# ------------------------------------------------------------------------------
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=prx
DB_DEFAULT_USER=prx
DB_DEFAULT_PASS=prx
DB_DEFAULT_SCHEMA=public


# ------------------------------------------------------------------------------
# 3. АДМИНИСТРАТОРЫ И ПЕРВИЧНАЯ ИНИЦИАЛИЗАЦИЯ (SEED)
# Владелец: pgMigration_Prx_110_004_DefaultAdmin, bin/console auth:user
# Обязательность: на production PRX_DEFAULT_ADMIN=0 и ADMIN_PASSWORD задан.
# ------------------------------------------------------------------------------
# Первичный администратор создаётся только на пустой базе.
PRX_DEFAULT_ADMIN=1
# Пусто = 'admin' (только для локальной разработки!).
PRX_DEFAULT_ADMIN_PASSWORD=
# PRX_DEFAULT_ADMIN_EMAIL=admin@example.test

# Параметры команды `make seed` (дополнительный администратор).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=


# ------------------------------------------------------------------------------
# 4. СЛУЖЕБНЫЕ ТОКЕНЫ И БЕЗОПАСНОСТЬ
# Владелец: application/config/*.php, application/classes/Controller/Prx39x/Api.php
# Обязательность: WORKER_API_TOKEN/WORKER_SITE_TOKEN — на production.
# ------------------------------------------------------------------------------
MIGRATIONS_TOKEN=
SITE_UPDATE_TOKEN=
# Основной токен взаимодействия воркеров с бэкендом.
WORKER_API_TOKEN=
WORKER_SITE_TOKEN=


# ------------------------------------------------------------------------------
# 5. ИИ / LLM (ОБЩИЕ ПРОВАЙДЕРЫ)
# Владелец: application/config/llm.php, workers/prx_workers/llm.py
# Обязательность: LOCAL_API_URL (или URL другого провайдера) — да.
# ------------------------------------------------------------------------------
# Провайдер по умолчанию. Имена: local, openrouter, toolforge.
# Пусто = local на сайте; воркеры берут первый настроенный.
LLM_DEFAULT_PROVIDER=local

# Модель платформы по умолчанию — используется модулем, у которого не задана
# своя <PRX>_MODEL. Формат: «провайдер::модель». Это НЕ то же самое, что
# LOCAL_DEFAULT_MODEL: здесь — выбор для всех модулей, там — модель провайдера.
DEFAULT_LLM_MODEL=local::unsloth/qwen3.8-27b

# --- Провайдер 1: Local (Ollama / vLLM / LM Studio / LocalAI) ---
LOCAL_API_URL=http://127.0.0.1:11434/v1
# Для LM Studio это Bearer-токен; для локального сервера без авторизации —
# любое непустое значение или `not-needed`.
LOCAL_API_KEY=not-needed
LOCAL_DEFAULT_MODEL=qwen3-coder-30b-a3b-instruct

# --- Провайдер 2: OpenRouter (облачный AI-шлюз) ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite

# --- Провайдер 3: Toolforge (корпоративный AI-шлюз) ---
# Отдельный провайдер, не «второе имя» для local. Модель указывается в
# спеке вызова: toolforge::<модель>.
TOOLFORGE_API_URL=
TOOLFORGE_API_KEY=


# ------------------------------------------------------------------------------
# 6. ЭМБЕДДИНГИ И СЕМАНТИЧЕСКИЙ ПОИСК
# Владелец: application/config/llm.php, workers/prx_workers/llm.py
# Обязательность: EMBEDDING_API_URL — если включён отдельный сервер эмбеддингов.
# ------------------------------------------------------------------------------
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32


# ------------------------------------------------------------------------------
# 7. OCR (РАСПОЗНАВАНИЕ СКАНОВ И PDF)
# Владелец: workers/prx_workers/ocr_client.py, канал doc.normalize
# Обязательность: OCR_SERVICE_URL — при OCR_PROVIDER=remote.
# ------------------------------------------------------------------------------
# tesseract — локально (dev), remote — внешний HTTP-сервис.
OCR_PROVIDER=tesseract
OCR_TIMEOUT=120

# Настройки для OCR_PROVIDER=remote.
OCR_SERVICE_URL=
OCR_API_KEY=
# Пусто = Authorization: Bearer <key>. Для сырого ключа: X-API-Key.
OCR_AUTH_HEADER_NAME=
# JSON-объект; уходит в multipart data= (output_format, lang, extract_tables…).
OCR_EXTRA_PARAMS={}
# JSON-объект; дополнительные HTTP-заголовки.
OCR_EXTRA_HEADERS={}


# ------------------------------------------------------------------------------
# 8. ФОНОВЫЕ ВОРКЕРЫ (ОБЩИЕ)
# Владелец: workers/prx_workers/config.py, application/modules/prx120_jobs
# Обязательность: WORKER_PG_DSN — в режиме pg; PRX120_API_URL — в режиме http
# (адрес очереди задаётся в блоке prx120 ниже).
# ------------------------------------------------------------------------------
WORKER_QUEUE_MODE=pg
WORKER_PG_DSN=postgres://prx:prx@127.0.0.1:5432/prx
WORKER_NAME=worker-1
WORKER_CHANNELS=echo,embeddings.index,llm.summarize,semantic.index,doc.normalize,doc.analyze,doc.draft
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5
WORKER_IDLE_MAX_SEC=10
WORKER_HEARTBEAT_INTERVAL=30
WORKER_LOG_LEVEL=INFO


# ==============================================================================
# 9. НАСТРОЙКИ МОДУЛЕЙ
# ==============================================================================
# Блоки идут от старых модулей к новым. Внутри блока — только env этого
# модуля; общие LLM, OCR, эмбеддинги и воркеры уже описаны выше.
# ==============================================================================

# --- prx115_semantic: семантический поиск ---
PRX115_API_BASE=http://localhost:8080/prx115/api
PRX115_SITE_TOKEN=
# Таймаут запроса эмбеддингов при индексации, секунды.
# PRX115_EMBED_TIMEOUT=120

# --- prx120_jobs: очередь и бюджеты LLM ---
PRX120_API_URL=http://localhost:8080/prx120/api
PRX120_API_BASE=http://localhost:8080
# Бюджеты: 0 = без лимита. Полный список ролей и периодов — в
# application/modules/prx120_jobs/config/prx120_budget.php.
# PRX120_BUDGET_ENFORCE=0
# PRX120_BUDGET_WARN_PCT=80
# PRX120_BUDGET_DAILY_SYSTEM=0
# PRX120_BUDGET_MONTHLY_SYSTEM=0

# --- prx208_events: подписчики из базы ---
# Выключено до аудита существующих обработчиков и уведомлений. См. ENVIRONMENT.md.
PRX208_DB_SUBSCRIBERS_ENABLED=0

# --- prx300_employee: кадровый импорт (CSV) ---
PRX300_IMPORT_MAX_BYTES=5242880
PRX300_IMPORT_MAX_ROWS=5000
PRX300_IMPORT_RETENTION_DAYS=180

# --- prx390_intake: входящие и OCR-текст ---
# Полный адрес нужен, если воркеры вынесены на отдельный хост.
# PRX390_API_BASE=http://localhost:8080/prx390/api
PRX390_SITE_TOKEN=
PRX390_INBOX_DIR=storage/docflow/inbox
PRX390_PROCESSED_DIR=storage/docflow/processed
PRX390_DUPLICATES_DIR=storage/docflow/duplicates
PRX390_ERROR_DIR=storage/docflow/error
PRX390_TEXT_RETENTION_DAYS=365

# --- prx391_documents: реестр и провенанс ---
PRX391_FIELD_EVENT_RETENTION_DAYS=730

# --- prx392_analysis: ИИ-разбор ---
# PRX392_API_BASE=http://localhost:8080/prx392/api
PRX392_SITE_TOKEN=
# Модель анализа. Пусто = DEFAULT_LLM_MODEL из раздела 5.
# PRX392_MODEL=local::openai/gpt-oss-20b
PRX392_RUN_RETENTION_DAYS=365

# --- prx393_workflow: сроки и маршруты ---
PRX393_SITE_TOKEN=

# --- prx394_drafts: проекты ответов ---
# PRX394_API_BASE=http://localhost:8080/prx394/api
PRX394_SITE_TOKEN=
# Модель ответов. Пусто = PRX392_MODEL, затем DEFAULT_LLM_MODEL.
# PRX394_MODEL=
PRX394_EMAIL_ENABLED=0

# --- prx398_vlm_demo: витрина vision-модели ---
# Не наследует DEFAULT_LLM_MODEL: vision-модель обязана поддерживать
# изображения, поэтому здесь свой явный дефолт.
# PRX398_VLM_MODEL=local::qwen_qwen3-vl-4b-instruct
# PRX398_ALLOWED_PROVIDERS=local

# --- prx597_notifications: почтовые уведомления ---
PRX597_EMAIL_ENABLED=0
EMAIL_DSN=
EMAIL_FROM=no-reply@example.test
EMAIL_FROM_NAME=PRX

# --- prx599_account: аккаунт пользователя ---
# PRX599_SCHEMA_AUTOCREATE=1


# ------------------------------------------------------------------------------
# 10. ДЕПЛОЙ И CI/CD
# Владелец: bin/deploy*, CI
# Обязательность: DEPLOY_BRANCH — на production.
# ------------------------------------------------------------------------------
DEPLOY_BRANCH=
