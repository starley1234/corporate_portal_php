{
  "name": "enterprise-llm-architecture",
  "version": "2.0.0",
  "private": true,
  "description": "Архитектура enterprise LLM-платформы как код: YAML -> HTML + JSON",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/arch.mjs check --strict",
    "test": "node --test",
    "serve": "node scripts/serve.mjs",
    "arch": "node scripts/arch.mjs",
    "status": "node scripts/arch.mjs status",
    "portfolio": "node scripts/portfolio.mjs --dir dept",
    "build:dept": "node scripts/build.mjs --dir dept",
    "check:dept": "node scripts/arch.mjs check --dir dept --strict",
    "mcp": "node scripts/mcp.mjs",
    "graph": "node scripts/arch.mjs graph"
  },
  "bin": {
    "arch": "scripts/arch.mjs",
    "arch-build": "scripts/build.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
