#!/usr/bin/env bash
# =============================================================================
# N2J — консоль (CLI-задачи Minion).
#
#   bin/console                          — список задач
#   bin/console db:migrate               — миграции
#   bin/console db:migrate --status      — состояние миграций
#   bin/console module:list              — инвентаризация модулей
#
# Скрипт подхватывает .env из корня проекта и находит PHP 8.4 (или любой php).
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# shellcheck source=bin/_env.sh
source "$(dirname "${BASH_SOURCE[0]}")/_env.sh"

# --- .env (внешнее окружение главнее файла) ----------------------------------
n2j_load_env "$ROOT/.env"

# --- PHP 8.4 или ближайший доступный -----------------------------------------
PHP_BIN="$(n2j_php_bin)" || true
if [[ -z "$PHP_BIN" ]]; then
    echo "ERROR: PHP не найден. Разворачивание: bash bin/restore-env.sh" >&2
    exit 1
fi

exec "$PHP_BIN" "$ROOT/public_html/index.php" "$@"
