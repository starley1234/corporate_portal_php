#!/usr/bin/env bash
# =============================================================================
# PRX — запуск тестов (phpunit).
# Если composer-зависимостей нет — сообщает, но не падает молча.
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# shellcheck source=bin/_env.sh
source "$(dirname "${BASH_SOURCE[0]}")/_env.sh"

# Окружение главнее файла: DB_DEFAULT_NAME от bin/check-fresh.sh переживает .env
prx_load_env .env

if [[ "${1:-}" == "--pdf" ]]; then
    echo "ERROR: --pdf удалён вместе с prx634; действующие PDF-проверки — tests/README.md" >&2
    exit 2
fi

PHP_BIN="$(prx_php_bin)" || { echo "ERROR: PHP не найден (bin/restore-env.sh)" >&2; exit 1; }

# Изолированные контракты выполняются отдельно: каждый определяет свои заглушки.
if [[ "${1:-}" == "--contracts" ]]; then
    shopt -s nullglob
    contracts=(tests/Contracts/*.php)
    if [[ ${#contracts[@]} -eq 0 ]]; then
        echo "ERROR: PHP-контракты не найдены в tests/Contracts" >&2
        exit 1
    fi
    failed=0
    for test in "${contracts[@]}"; do
        echo "==> $test"
        if ! "$PHP_BIN" "$test"; then
            failed=1
        fi
    done
    exit "$failed"
fi

if [[ -f vendor/bin/phpunit ]]; then
    exec "$PHP_BIN" vendor/bin/phpunit -c phpunit.xml.dist "$@"
fi

# Статическая проверка приоритетов `= … AND …`. Это не «ещё один линтер ради
# галочки»: такая строка не падает и не ловится php -l, но молча присваивает
# только левый операнд. 23.10.2026 она стоила бесконечной перезагрузки
# админки MCP Hub (`$run_running = $run AND $run['status'] === 'running'`),
# а до этого — неверных статусов в prx120 и «админ = вошёл» в prx605/prx670.
# Проверка отдельным шагом: падение тестов и предупреждение линтера нельзя
# смешивать в один вывод.
if command -v python3 >/dev/null 2>&1 && [[ -f .tools/php_ternary_lint.py ]]; then
    if python3 -c "import tree_sitter, tree_sitter_php" >/dev/null 2>&1; then
        echo "==> Приоритеты and/or в присваиваниях (php_ternary_lint)"
        if ! python3 .tools/php_ternary_lint.py application; then
            echo "FAIL: `= … AND/OR …` присваивает только первый операнд — поставьте скобки" >&2
            exit 1
        fi
        echo
    else
        echo "SKIP: tree-sitter не установлен (pip3 install tree_sitter tree_sitter_php)" >&2
    fi
fi

# Fallback для сред без composer/packagist (закрытая сеть): мини-раннер
# прогоняет tests/Smoke и tests/Unit без phpunit.
if [[ -f tests/Support/mini_runner.php ]]; then
    exec "$PHP_BIN" tests/Support/mini_runner.php "$@"
fi

echo "phpunit не установлен (нет vendor/). Варианты:"
echo "  1) composer install          — локально"
echo "  2) make up && make shell     — внутри контейнера: vendor/bin/phpunit"
exit 1
