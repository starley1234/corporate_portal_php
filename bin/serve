#!/usr/bin/env bash
# =============================================================================
# PRX — dev-сервер на встроенном PHP (без nginx).
#
#   PORT=8080 bin/serve
#
# Для продакшена используйте docker compose (nginx + php-fpm).
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${PORT:-8080}"

# shellcheck source=bin/_env.sh
source "$(dirname "${BASH_SOURCE[0]}")/_env.sh"
prx_load_env "$ROOT/.env"

PHP_BIN="$(prx_php_bin)" || true
if [[ -z "$PHP_BIN" ]]; then
    echo "ERROR: PHP не найден. Разворачивание: bash bin/restore-env.sh" >&2
    exit 1
fi

echo "==> http://0.0.0.0:${PORT}  (docroot: public_html, PHP: $("$PHP_BIN" -r 'echo PHP_VERSION;'))"
exec "$PHP_BIN" -S "0.0.0.0:${PORT}" -t "$ROOT/public_html" "$ROOT/bin/router.php"
